#!/usr/bin/env python3
"""Settle a push to a PR branch: prove its runs are running, correct them if not.

Extensionless and executable because agents type it as a command mid-session,
unlike model-intel.py which a workflow feeds to python3.

The rule this replaces was a model of GitHub's attribution logic: who pushed,
which actor the resulting event carries, which of those actors GitHub holds at
the approval gate. That model is undocumented in parts and free to change under
us (agents/GOVERNANCE.md, "Push identity", records the seven incidents that
built it). What the rule exists to achieve is observable directly: after a push,
are the runs it triggered actually running? That is a documented API field, so
this checks the result instead of predicting it, and stays correct if GitHub
moves the attribution rules.

Settled means: every workflow that has a run at this SHA has at least one run
that is not held at the approval gate. Held runs are never cleared, only
outrun -- re-attribution starts fresh runs beside them (close/reopen carries
claude[bot], whose runs start unheld), so per-workflow liveness is the honest
question, not "is any run held".

Settled is a claim about ONE commit: the one the caller pushed. The PR's head
is not that commit until it catches up, so the SHA is taken from push-branch's
own record of what it pushed from this checkout (push-branch-refs.json, per
branch) and `--sha` overrides it. Where neither is available the answer is
reported unverified, never settled. Local HEAD is never consulted: push-branch
writes through the git data API and does not advance the checkout, so on the
documented flow HEAD is the branch BASE, the exact SHA the head-mismatch
check exists to alarm on, and inferring it alarmed on every push (issue #421).

Silence is never success. A push whose runs never appear looks exactly like a
push whose runs are fine, so no-runs-within-the-timeout is a loud, distinct,
non-zero outcome -- that indistinguishability is the failure this mechanism
exists not to rebuild.
"""
import json, os, subprocess, sys, time

TIMEOUT = 120  # seconds to wait for runs to appear; they normally show in <10
HEAD_TIMEOUT = 30  # seconds for the PR's head to catch up with the push
POLL = 5


def gh(*args):
    """Run gh with the session's own credential; no token logic lives here."""
    proc = subprocess.run(("gh",) + args, capture_output=True, text=True)
    if proc.returncode != 0:
        hint = ("The app token expires about an hour into a session (issue #81);"
                if "401" in proc.stderr or "Bad credentials" in proc.stderr else
                "Fix the call above, then re-run this.")
        die(f"`gh {' '.join(args)}` failed: {proc.stderr.strip()}", hint)
    return proc.stdout


def die(*lines):
    print("settle-push: " + "\n  ".join(lines), file=sys.stderr)
    sys.exit(1)


def git(*args):
    """Read-only git, or None outside a worktree: absence is an answer here."""
    proc = subprocess.run(("git",) + args, capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else None


# push-branch records every push per branch under this name (its OWN_PUSHES).
# The filename is the interface between the two scripts; settle-push.test.mjs
# pins them together, because a silent split would demote every no---sha run
# to "unverified" forever with no failure anywhere.
OWN_PUSHES = "push-branch-refs.json"


def pushed_sha(branch):
    """What push-branch pushed to `branch` from this checkout, or None."""
    path = git("rev-parse", "--git-path", OWN_PUSHES)
    if not path:
        return None
    try:
        with open(path) as fh:
            return json.load(fh).get(branch)
    except (OSError, ValueError):
        return None


def same(sha, other):
    """SHAs match if either is a prefix of the other; callers abbreviate."""
    return sha.startswith(other) or other.startswith(sha)


def die_conflicting(pr, branch):
    """A conflicted PR has no merge ref, so ci and agent-review cannot fire.

    Naming that beats reporting their absence as missing runs: the misreport
    sent PR #336's rescue down a 25-minute wrong-cause hunt (issue #338)."""
    die(f"PR #{pr} is CONFLICTING with main (issue #200's class).",
        "GitHub builds no merge ref for it, so ci and agent-review will not",
        "fire on this head and the PR cannot merge. Runs are not the problem;",
        "the conflict is. Rescue:",
        f"1. In a checkout of `{branch}`: git fetch origin && git merge origin/main",
        "   Resolve mechanically (append conflicts keep both sides), commit.",
        f"2. .github/scripts/push-branch {pr} --merge $(git rev-parse origin/main)",
        f"3. .github/scripts/settle-push {pr} --sha <the printed sha>")


def report(pr, sha, branch, grouped, expected):
    """Print the liveness result, naming what the claim is about.

    A certification of the wrong commit reads exactly like a certification of
    the right one, so the weaker claim gets a different first word rather than
    a footnote (issues #146, #158).
    """
    live = ", ".join(sorted(grouped))
    if expected:
        print(f"settled: {sha[:9]} has live runs for {live}")
        return
    print(f"unverified: PR #{pr} head {sha[:9]} has live runs for {live}."
          f" Nothing here says {sha[:9]} is the commit you pushed: no --sha,"
          f" and push-branch recorded no push to `{branch}` from this checkout."
          " Re-run with --sha <pushed-sha> to certify.")


def runs_for(repo, sha):
    """Runs at this SHA as (id, workflow name, held at the approval gate?)."""
    payload = json.loads(gh("api", f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100"))
    return [(run["id"], run["name"],
             "action_required" in (run.get("status"), run.get("conclusion")))
            for run in payload.get("workflow_runs", [])]


def observe(repo, sha, deadline):
    """Poll until the run set stops changing, then report the held workflows.

    A set that is still growing is not evidence: on PR #131 the CodeQL run
    existed while ci and agent-review did not yet, and reading once would have
    called that settled. Identity is the run id, not the workflow name --
    after a re-attribution the names repeat, and only the ids say the fresh
    runs actually arrived.
    """
    previous, runs = None, []
    while True:
        runs = runs_for(repo, sha)
        ids = {run_id for run_id, _, _ in runs}
        if (runs and ids == previous) or time.monotonic() >= deadline:
            break
        previous = ids
        time.sleep(POLL)
    if not runs:
        return {}, None
    grouped = {}
    for _, name, held in runs:
        grouped.setdefault(name, []).append(held)
    return grouped, [name for name, held in grouped.items() if all(held)]


def main():
    args = sys.argv[1:]
    pr = next((a for a in args if not a.startswith("-")), None)
    if not pr:
        die("usage: .github/scripts/settle-push <pr-number> [--sha <pushed-sha>]",
            "Run it right after pushing to that PR's branch;"
            " --sha defaults to push-branch's recorded push to that branch.")
    expected = args[args.index("--sha") + 1] if "--sha" in args else None

    repo = os.environ.get("GITHUB_REPOSITORY") or gh(
        "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip()
    pull = json.loads(gh("pr", "view", pr, "--json", "headRefOid,state,headRefName,mergeable"))
    branch = pull["headRefName"]
    # An expected SHA is what gives the wait below anything to wait for: with
    # none, the loop broke on its first read and certified whatever the API
    # returned, the pre-push commit on PRs #143 and #155 (issues #146, #158).
    # push-branch's record is the commit the caller means; local HEAD was the
    # previous default and is the branch BASE on the documented flow (#421).
    if expected is None:
        expected = pushed_sha(branch)

    # The PR's head lags the push by a second or two, so a mismatch is only
    # news once it has had time to settle. Diagnosing a healthy push as a lost
    # one is the same defect as calling silence health, just louder.
    deadline = time.monotonic() + HEAD_TIMEOUT
    while expected and not same(pull["headRefOid"], expected):
        if time.monotonic() >= deadline:
            break
        time.sleep(POLL)
        pull = json.loads(gh("pr", "view", pr, "--json", "headRefOid,state,headRefName,mergeable"))
    sha, state = pull["headRefOid"], pull["state"]

    if expected and not same(sha, expected):
        die(f"PR #{pr} head is still {sha[:9]} after {HEAD_TIMEOUT}s,"
            f" not the {expected[:9]} you pushed.",
            f"The push did not reach `{branch}`. The known cause is",
            "commit_files on a PR-comment run, which creates a literal `<n>/merge`",
            "branch parented on main instead (observed on PR #78).",
            "1. Check `git ls-remote origin` for a stray ref.",
            "2. Re-push with `.github/scripts/push-branch <pr> <path>...`.",
            "3. If you deliberately pushed a commit this checkout does not have,",
            "   name it: --sha <pushed-sha>.")
    if state != "OPEN":
        die(f"PR #{pr} is {state}, so there is nothing to settle.")
    if pull["mergeable"] == "CONFLICTING":
        die_conflicting(pr, branch)

    grouped, stuck = observe(repo, sha, time.monotonic() + TIMEOUT)
    if stuck is None:
        # Silence has two causes with different rescues, and `mergeable` is
        # the field that separates them. It reads UNKNOWN while GitHub
        # computes, so give a definite answer a moment to form.
        mergeable = pull["mergeable"]
        deadline = time.monotonic() + HEAD_TIMEOUT
        while mergeable == "UNKNOWN" and time.monotonic() < deadline:
            time.sleep(POLL)
            mergeable = json.loads(gh("pr", "view", pr, "--json", "mergeable"))["mergeable"]
        if mergeable == "CONFLICTING":
            die_conflicting(pr, branch)
        die(f"No runs appeared for {sha[:9]} within {TIMEOUT}s.",
            "Silence is not health. Either the push never reached the branch, or",
            "every workflow filtered it out by path, or Actions is degraded.",
            f"1. `gh pr checks {pr}` to see what GitHub thinks exists.",
            "2. https://www.githubstatus.com if that is empty too.")
    if not stuck:
        report(pr, sha, branch, grouped, expected)
        return

    # Correction: re-attribute the event. Reopening carries claude[bot], whose
    # runs start unheld; the held runs stay held forever and are simply outrun.
    print(f"held at the approval gate: {', '.join(sorted(stuck))} -- re-attributing")
    gh("pr", "close", pr)
    gh("pr", "reopen", pr)
    grouped, stuck = observe(repo, sha, time.monotonic() + TIMEOUT)

    if stuck:
        die(f"Still held after re-attribution: {', '.join(sorted(stuck))}.",
            "Re-attribution is the only lever an agent has; no agent token can",
            "approve a held run (PR #43).",
            f"1. Say so on PR #{pr}, naming the held workflows.",
            "2. Label it blocked-on-human and move on.")
    report(pr, sha, branch, grouped, expected)


if __name__ == "__main__":
    main()
