#!/usr/bin/env python3
"""File the mutants that outlived their pull request, so a red that lands after the merge still has a reader.

Extensionless and executable, like survey-due and stalled-prs: a decision
nobody was making gets made here, every run, by the workflow itself.

mutants-check is advisory (docs/TESTING.md, tier "Advisory"), and the reviewer
reads its red on the PR thread when the red exists by the time the review
posts. When it does not, nobody does: the reviewer's session ends with its
verdict, merge-pr lands the PR on the required gates alone, and the check
finishes minutes later on a thread no seat sweeps. Three PRs merged that way
in two days (2026-09-22/23): #676 and #677 with one and two survivors each,
#690 with 50 survivors among 84 decided mutants and 20 never run, its
mutate step cut at the 25-minute budget. Every one of those survivors is a
line on main no test distinguishes from its mutation, and the only record
was a `::warning` annotation on a closed PR.

A cut run is the second silence (#947): the step's budget ends, the mutants
it never reached have no outcome and no file names them, and an empty
`missed.txt` read alone says "clean" when the truth is "undecided". Five
cuts in 17 days, the last on the FORMAT_VERSION 12 decoder (#1085), read
as "no survivors" and merged. So the listing is read against the outcomes
by name, and every line this script prints ends in `undecided N of M`: N
mutants the run listed and never decided, M it listed. Zero is the
liveness signal; a decode-safety undecided mutant is debt in the same
sense as a survivor and is filed with them.

Run as the mutants job's last step, after the report exists:

    mutants-debt <pr-number> [mutants-out-dir]

and it does one of five things, printed on one line:

    no survivors     nothing owed in decode-safety territory and no
                     scaffold survivor; nothing to file
    scaffold         every survivor sits outside decode-safety territory
                     (TERRITORY below, ADR-0056): a map reading, not debt,
                     left on the diff's annotations; nothing to file
    open             the PR is still open, so its red on the thread is the
                     reader (agent-review.yml's step 3 names the annotations)
    filed already    an open issue already carries this PR's debt
    filed #N         the PR is merged: its decode-safety survivors and
                     undecided mutants become one issue, labeled `product`
                     + `bug`, slot a of the heartbeat's product queue, so
                     the fix lands while the diff is still warm

The issue is written by gh-comment (footer, credential), never by `gh issue
create`, and posted as the reviewer: the survivor rule is agent-review.yml
step 3's, and this is that rule's arm on a thread the reviewer has left. A
seat's name, because gh-comment.test.mjs's roster test refuses a footer for
a seat nobody staffs (review, PR #693). It names the three answers a survivor takes in the house's order:
delete the line, then a test, then a proven exclusion. Deletion first
because a survivor in code nothing calls is dead code, not a missing test
(PR #690's 19 codec.rs survivors were all in a measurement sink with no
caller), and PERSONALITY.md ranks deletion over addition.

Not covered, by design: a PR that merges in the seconds between the state
read and the filing; the monthly whole-crate sweep (#455) is the backstop
for that gap and for everything that predates this step. Fail direction: an
unreadable PR state or a failed filing exits 1 so the run's red says why,
because printing the survivors to a log nobody opens is the exact failure
this script exists to end.

`triage`, `decide`, `render` and `in_territory` are pure so
mutants-debt.test.mjs can pin both failure directions without spawning gh;
`read_report` reads the three files cargo-mutants leaves and nothing else.
"""

import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

LABELS = ("product", "bug")
TITLE_MARK = "outlived PR #"

# Decode-safety territory (ADR-0056): a merged PR's survivor is filed only
# when the mutated function is one hard rule 2's claim reaches, recognised
# by the tokens this crate's decode-path functions carry (decode, decompress,
# undo, replay, read_, bound, ensure_room) or by living in coder.rs, whose
# every line is the range coder's termination. A token rule, not a path
# list, so a new decode function is covered the day it is named like one.
# The cheap failure direction is under-filing: torture, the adversarial
# seeds and the nightly fuzz still cover the decode path. Survivors outside
# the territory are scaffold (docs/TESTING.md "Two classes"): annotated on
# the open diff for the reviewer, never filed.
TERRITORY = re.compile(
    r"^src/coder\.rs:|decode|decompress|undo|replay|read_|bound|ensure_room",
    re.IGNORECASE,
)

# Proven non-match (ADR-0056 PR #854 review): `stretch_bound` is
# `LogitSse`'s logit-domain clamp range, model arithmetic with no
# allocation or untrusted-input surface, so it reads as decode-safety on
# the bare "bound" token despite failing every test hard rule 2 states.
# Scoped to the one function proven scaffold; a new decode function is
# still caught, named or not.
SCAFFOLD_OVERRIDE = re.compile(r"\bstretch_bound\b")


def in_territory(line):
    """Whether one mutant name (a `missed.txt` line, a `mutants.json` entry) names decode-safety territory."""
    if SCAFFOLD_OVERRIDE.search(line):
        return False
    return TERRITORY.search(line) is not None


@dataclass
class Debt:
    """One run's report, sorted by the territory rule: what is owed on main and what is a map reading.

    Each mutant is its cargo-mutants name, `file:line:col: replace ...`,
    the form `missed.txt` lists and `mutants.json` carries.
    """

    missed: list  # survivors in decode-safety territory
    outside: int  # survivors outside it: scaffold, never filed
    undecided: list  # listed, never run, in decode-safety territory (#947)
    undecided_outside: int  # listed, never run, outside it
    generated: int  # mutants the run listed; 0 when the diff touched no src line

    @property
    def owed(self):
        """"2 survivors", "3 undecided", both comma-joined, or "" when nothing is owed on main."""
        parts = []
        if self.missed:
            parts.append(plural(len(self.missed), "survivor"))
        if self.undecided:
            parts.append(f"{len(self.undecided)} undecided")
        return ", ".join(parts)

    @property
    def never_ran(self):
        """Mutants the run listed and never decided, territory or not: the liveness count."""
        return len(self.undecided) + self.undecided_outside


def plural(n, noun):
    return f"{n} {noun}{'s' if n != 1 else ''}"


def triage(missed, undecided, generated):
    """Sort survivors and never-run mutants by territory into one Debt."""
    owed_missed = [line for line in missed if in_territory(line)]
    owed_undecided = [name for name in undecided if in_territory(name)]
    return Debt(
        missed=owed_missed,
        outside=len(missed) - len(owed_missed),
        undecided=owed_undecided,
        undecided_outside=len(undecided) - len(owed_undecided),
        generated=generated,
    )


def gh_json(args):
    """(parsed stdout, error text): gh's JSON or why it could not be read."""
    proc = subprocess.run(["gh", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        return None, proc.stderr.strip() or f"gh exited {proc.returncode}"
    try:
        return json.loads(proc.stdout), None
    except json.JSONDecodeError as exc:
        return None, f"gh printed non-JSON: {exc}"


def read_report(out_dir):
    """(sorted missed lines, sorted never-run mutant names, mutants listed) from a cargo-mutants output directory.

    cargo-mutants writes `mutants.json` (every mutant it will try) before
    the baseline and appends to `outcomes.json` as each mutant is decided,
    so a run cut by the step's budget leaves names in the listing with no
    outcome: those are the never-run set. An absent listing is a run that
    found nothing to mutate (a diff with no src line leaves no `mutants.out`
    at all), so it reads as zero listed; a crash before the listing is the
    mutate step's own red. A listing or outcome file that exists and does
    not parse raises, so the run's red says which file.
    """
    out = Path(out_dir)
    missed = []
    missed_path = out / "missed.txt"
    if missed_path.is_file():
        missed = sorted(line for line in missed_path.read_text().splitlines() if line.strip())
    listed = []
    listing = out / "mutants.json"
    if listing.is_file():
        listed = [mutant["name"] for mutant in json.loads(listing.read_text())]
    decided = set()
    outcomes = out / "outcomes.json"
    if outcomes.is_file():
        for outcome in json.loads(outcomes.read_text()).get("outcomes", []):
            scenario = outcome.get("scenario")
            if isinstance(scenario, dict) and "Mutant" in scenario:
                decided.add(scenario["Mutant"]["name"])
    undecided = sorted(name for name in listed if name not in decided)
    return missed, undecided, len(listed)


def decide(debt, merged, filed):
    """The verdict and its one-line reason.

    debt: the run's triaged report; merged: the PR's merged state, None
    when unreadable; filed: an existing open issue number, None when absent
    or unreadable.
    """
    if not debt.owed and not debt.outside:
        return "no survivors", "nothing owed in decode-safety territory"
    if not debt.owed:
        return "scaffold", f"{debt.outside} survivor(s) outside decode-safety territory; scaffold, not filed (ADR-0056)"
    if merged is None:
        return "unreadable", "PR state could not be read"
    if not merged:
        return "open", f"{debt.owed} on the open PR; its red on the thread is the reader"
    if filed:
        return "filed already", f"#{filed} carries this PR's {debt.owed}"
    return "file", f"{debt.owed} on merged code"


def render(pr, debt, run_url):
    """(title, body) for the issue the merged PR's decode-safety debt becomes."""
    files = sorted({line.split(":", 1)[0] for line in [*debt.missed, *debt.undecided]})
    title = f"mutants: {debt.owed} {TITLE_MARK}{pr} ({', '.join(files)})"
    lines = [
        f"PR #{pr} merged while its mutants-check was still running; the check",
        "finished red afterwards, on a thread no seat reads.",
    ]
    if debt.missed:
        lines += [
            "",
            "Survivors, each a line on main no test distinguishes from its mutation:",
            "",
            "```",
            *debt.missed,
            "```",
        ]
    if debt.undecided:
        lines += [
            "",
            f"Undecided, each a mutant the step's time budget ended before it ran ({debt.never_ran} of",
            f"{debt.generated} listed never ran): debt in the same sense as a survivor until a run over",
            "this code decides it (#947):",
            "",
            "```",
            *debt.undecided,
            "```",
        ]
    if debt.outside:
        lines += [
            "",
            f"{debt.outside} more {'survivors sit' if debt.outside != 1 else 'survivor sits'} outside decode-safety territory:",
            "scaffold, not debt (ADR-0056), left on the PR's annotations.",
        ]
    lines += [
        "",
        "Each survivor takes one of three answers, in this order: delete the line",
        "(a survivor in code nothing calls is dead code, not a missing test, unless",
        "the `compression-experiment` skill keeps it until its wiring slice), a test",
        "that fails under the mutation, or an exclusion in `tests/mutants.toml` with",
        "the equivalence proof (#391's shape). Procedure: the `test-craft` skill.",
    ]
    if debt.undecided:
        lines += [
            "An undecided mutant is run first, `cargo mutants --config tests/mutants.toml",
            "--package mothergod --re '<its name>'`, then answered as a survivor or closed as caught.",
        ]
    lines += [
        "",
        f"Run: {run_url}",
    ]
    return title, "\n".join(lines)


def pr_merged(repo, pr):
    data, err = gh_json(["pr", "view", str(pr), "--repo", repo, "--json", "state"])
    if err:
        return None, err
    return data.get("state") == "MERGED", None


def already_filed(repo, pr):
    data, err = gh_json([
        "issue", "list", "--repo", repo, "--state", "open", "--label", LABELS[1],
        "--search", f'in:title "{TITLE_MARK}{pr} "', "--json", "number,title",
    ])
    if err:
        return None, err
    for issue in data:
        if f"{TITLE_MARK}{pr} " in issue.get("title", ""):
            return issue["number"], None
    return None, None


def file_issue(title, body):
    """The new issue's number via gh-comment --new, or None with gh-comment's complaint."""
    script = Path(__file__).with_name("gh-comment")
    cmd = [str(script), "--new", title]
    for label in LABELS:
        cmd += ["--label", label]
    proc = subprocess.run(cmd, input=body, capture_output=True, text=True)
    if proc.returncode != 0:
        return None, proc.stderr.strip() or proc.stdout.strip()
    return proc.stdout.strip(), None


def main():
    if len(sys.argv) < 2:
        print("usage: mutants-debt <pr-number> [mutants-out-dir]", file=sys.stderr)
        return 2
    pr = int(sys.argv[1])
    out_dir = sys.argv[2] if len(sys.argv) > 2 else "mutants.out"
    repo = os.environ.get("GITHUB_REPOSITORY", "bugabinga/mothergod")
    run_url = os.environ.get("RUN_URL", "(run url unset)")

    debt = triage(*read_report(out_dir))
    liveness = f"undecided {debt.never_ran} of {debt.generated}"
    merged = filed = None
    err = None
    if debt.owed:
        merged, err = pr_merged(repo, pr)
        if merged:
            filed, err = already_filed(repo, pr)
            if err:
                filed = None  # a dedup read that failed must not suppress the filing
    verdict, detail = decide(debt, merged, filed)
    if verdict == "unreadable":
        print(f"::error::mutants-debt: {detail}: {err} | {liveness}")
        return 1
    if verdict != "file":
        print(f"mutants-debt: {verdict} | {detail} | {liveness}")
        return 0
    title, body = render(pr, debt, run_url)
    created, err = file_issue(title, body)
    if err:
        print(f"::error::mutants-debt: filing failed: {err} | {liveness}")
        return 1
    print(f"mutants-debt: filed {created} | {detail} | {liveness}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
