#!/usr/bin/env python3
"""Post one issue comment, close an issue with one, or open an issue, on the credential meant for it.

Extensionless and executable because agents type it as a command mid-session,
like tg-send and push-branch.

This exists because "type the footer by hand" and "never post routine
comments with the admin PAT" both failed the same way: issue #5 and #82 were
closed with comments that carried neither the footer nor the app-token
identity (2026-08-23 23:13), which meant the self-trigger guard
(agent-bdfl.yml, matching `[Claude Code](https://claude.ai/code)` in the
causing comment body per issue #142) had nothing to match, and the operator-
attributed close woke a fresh BDFL run -- exactly the loop issue #50 already
named and GOVERNANCE already forbids in prose. A rule an agent has to
remember to apply, every time, forever, is a rule that will eventually not
be applied; issue #138 proposed assembling the footer once instead of
teaching five agents to type it. This is that assembly point for issue
comments, and it closes the credential half too: it reads GH_WORKFLOW_TOKEN
(the comments-only fallback already wired into agent-bdfl.yml, issue #81)
and never consults GH_ADMIN_TOKEN or an ambient GH_TOKEN, so a shell that
exported the admin PAT for an earlier workflow-file push cannot leak it into
a routine comment by accident.

Creation (`--new`) rides the same credential for a second reason, issue #489:
the app token expires about an hour into a session, and a run that measures
for two hours cannot file what it learned. The workflow token has no such
clock, so an issue filed at minute 130 lands exactly like one filed at minute
three. That is not a fallback path with a trigger condition to remember; it
is the only path, which is why there is nothing here to get wrong.

Scope: issues only, and that boundary is load-bearing, not laziness. This
credential must NEVER open a pull request, because GitHub raises no workflow
run from an event its own `GITHUB_TOKEN` caused, so the PR would be born
with no `ci` and no reviewer, forever (the argument in full, and what
catches the run that needed one: GOVERNANCE "Stalled auto-merge", sixth
signature). A PR is also an issue node, but `gh issue comment` fails on a PR
argument, and PR review threads have their own posting path; wire those in
when the need shows up rather than guessing the shape now.

Usage: gh-comment <issue-number> [--close] < body
       gh-comment --new "<title>" [--label NAME]... < body
Prints the comment's or the new issue's URL on stdout.
"""

import argparse
import os
import subprocess
import sys

FOOTER = "\n\n---\n_{role} · [Claude Code](https://claude.ai/code)_"


def die(*lines):
    for line in lines:
        print(f"gh-comment: {line}", file=sys.stderr)
    sys.exit(1)


def main() -> int:
    parser = argparse.ArgumentParser(prog="gh-comment", description=__doc__.splitlines()[0])
    parser.add_argument("number", nargs="?", help="the issue to comment on or close")
    parser.add_argument("--close", action="store_true", help="close it, body as the closing comment")
    parser.add_argument("--new", metavar="TITLE", help="open a new issue with this title")
    parser.add_argument("--label", action="append", default=[], metavar="NAME",
                        help="label for --new, repeatable")
    args = parser.parse_args()

    # `is not None`, because an empty --new is a typo, not an absent flag, and
    # falsiness would send it to the "give me an issue number" error instead.
    if args.new is not None:
        if not args.new.strip():
            die("--new needs a title; an issue nobody can scan is nobody's work")
        if args.number or args.close:
            die("--new opens an issue; it takes no number and cannot --close one")
    else:
        if not args.number or not args.number.isdigit():
            die("usage: gh-comment <issue-number> [--close] < body",
                "       gh-comment --new \"<title>\" [--label NAME]... < body")
        if args.label:
            die("--label applies to --new only; label an existing issue with `gh issue edit`")

    role = os.environ.get("ROLE", "")
    if not role:
        die("ROLE is not set; the calling workflow must export it")

    body = sys.stdin.read().strip()
    if not body:
        die("empty body; refusing to post")
    full_body = body + FOOTER.format(role=role)

    token = os.environ.get("GH_WORKFLOW_TOKEN", "")
    if not token:
        die(
            "GH_WORKFLOW_TOKEN is not set; this never falls back to GH_TOKEN "
            "or GH_ADMIN_TOKEN, because an ambient admin token is exactly "
            "the bug this script exists to close (issue #50)",
        )
    env = dict(os.environ)
    env["GH_TOKEN"] = token
    env.pop("GH_ADMIN_TOKEN", None)

    if args.new is not None:
        call = ["issue", "create", "--title", args.new, "--body", full_body]
        for label in args.label:
            call += ["--label", label]
        target = f"a new issue titled {args.new!r}"
    else:
        call = ["issue", "close" if args.close else "comment", args.number]
        call += ["--comment" if args.close else "--body", full_body]
        target = f"issue {args.number}"
    result = subprocess.run(["gh"] + call, env=env, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"gh {' '.join(call[:2])} on {target} failed: {result.stderr.strip()}")
    print(result.stdout.strip())
    return 0


if __name__ == "__main__":
    sys.exit(main())
