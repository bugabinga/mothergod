#!/usr/bin/env python3
"""Strip the credentials the harness leaves in the checkout's git config (SessionStart hook).

`.claude/settings.json` wires this as a SessionStart hook; the harness runs
it once, after the action has configured git and before the model's first
tool call. Extensionless and executable like the deny-* hooks; no agent
types it.

claude-code-action authenticates git by rewriting `remote.origin.url` to
`https://x-access-token:<token>@github.com/<owner>/<repo>.git`
(src/github/operations/git-config.ts, replaceCheckoutCredentials). From
then on `git remote -v`, `git config --list`, `cat .git/config` and any
git error that quotes the URL print a live installation token, and two
runs did: 33435174432 (#425) and the herald's 35316583064 (#596). Nothing
in this repository consumes that credential: push-branch replaced
`git push` with four data-API calls on an explicitly passed token, and
the repository is public, so `git fetch` needs none. secret_scrub.py
filters the token's echoes at every exit; this hook removes the source
(issue #597).

The runner's own checkout leaves a second one: actions/checkout persists
its token as `http.https://github.com/.extraheader`, a base64 basic header
that `git config --list` prints whole. The reviewer's run 36094012470 did
exactly that into its transcript while verifying #749's scrub rule (the
token was hour-scoped and dead before anyone read it, which is luck, not
a control). Nothing consumes it either, for the same reasons as above, so
this hook removes it too. `persist-credentials: false` on every checkout
would do the same per workflow, one line that drifts the day a workflow
is added and that nothing lints (#556); this runs for every session.

Upstream offers no switch. The action's credential-helper path keeps the
URL clean but is keyed to `allowed_non_write_users`, which also widens who
may trigger a run and scrubs the environment out of every subprocess, so
a repository that only wants a clean remote cannot reach it. A hook is
the one in-repo point that runs after the action writes the URL and
before any tool can print it.

Contract: outside GitHub Actions (GITHUB_ACTIONS != "true") this does
nothing; a human's local git config is theirs. In CI it reads
`remote.origin.url` of the checkout (CLAUDE_PROJECT_DIR, else the working
directory) and, if the URL carries userinfo (`https://<anything>@host`),
rewrites it without; then it unsets every `http.https://github.com/.extraheader`
value at the file each one actually resolves from (`--show-origin`), since
actions/checkout writes the header into a file pulled in by `includeIf`,
not the repo's own `.git/config`, and a plain `--unset-all` only ever
targets the latter. Neither the URL nor a header value is ever printed,
in any state. Always exits 0: a hook that fails a session start over git
cosmetics is a worse defect than the leak it prevents.

Liveness: one line on stdout, which the harness adds to the model's
context, and the same line appended to GITHUB_STEP_SUMMARY, the durable
trace, one clause per credential. `removed` means the hook earns its
keep. `already clean` on both clauses means the harness stopped leaving
credentials behind and this file is dead weight to delete.
"""

import os
import re
import subprocess
import sys

# Userinfo in an http(s) URL is a credential by construction, at any length
# and in any format; secret_scrub.URL_USERINFO makes the same argument. The
# scheme is kept, everything up to and including the `@` is dropped.
CREDENTIALED = re.compile(r"^(?P<scheme>https?://)[^/@]+@(?P<rest>.+)$", re.IGNORECASE)


def git(repo, *args):
    """Run git against `repo`, capturing both streams so no URL escapes."""
    return subprocess.run(
        ["git", "-C", repo, *args], capture_output=True, text=True, check=False
    )


def report(line):
    """The one liveness line, to the model's context and the durable summary."""
    print(line)
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")


# The key actions/checkout writes its persisted token under (git-auth-helper.ts).
EXTRAHEADER = "http.https://github.com/.extraheader"


def scrub_origin(repo):
    """Rewrite a credentialed origin without its userinfo; the clause for the line."""
    got = git(repo, "config", "--get", "remote.origin.url")
    if got.returncode != 0:
        return None  # No origin: nothing to leak, nothing to say.
    match = CREDENTIALED.match(got.stdout.strip())
    if not match:
        return "origin already clean"
    clean = match["scheme"] + match["rest"]
    if git(repo, "remote", "set-url", "origin", clean).returncode != 0:
        print("scrub-remote: could not rewrite origin", file=sys.stderr)
        return None
    return "origin credential removed"


def extraheader_files(repo):
    """Distinct files the extraheader value actually resolves from.

    actions/checkout persists the header in an external file pulled in via
    an `includeIf` stanza (git-auth-helper.ts), not a write into the repo's
    own `.git/config`. Plain `--unset-all` has no `--file` and always writes
    to the repo's local config, so it silently no-ops against that layout.
    `--show-origin` reports the file each matching line actually came from;
    only the origin, never the value, is read here.
    """
    result = git(repo, "config", "--show-origin", "--get-all", EXTRAHEADER)
    if result.returncode != 0:
        return []
    files = []
    for line in result.stdout.splitlines():
        origin, _, _value = line.partition("\t")
        if origin.startswith("file:"):
            path = origin[len("file:") :]
            if path not in files:
                files.append(path)
    return files


def scrub_extraheader(repo):
    """Unset every persisted extraheader value at its real file; the clause for the line."""
    files = extraheader_files(repo)
    if not files:
        return "extraheader already clean"
    ok = True
    for path in files:
        if git(repo, "config", "--file", path, "--unset-all", EXTRAHEADER).returncode != 0:
            ok = False
    if not ok:
        print("scrub-remote: could not unset the extraheader", file=sys.stderr)
        return None
    return "extraheader removed"


def main() -> int:
    """Strip both credentials; always exit 0."""
    if os.environ.get("GITHUB_ACTIONS") != "true":
        return 0
    repo = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    try:
        if git(repo, "rev-parse", "--git-dir").returncode != 0:
            return 0  # No repository: nothing to leak.
        clauses = [scrub_origin(repo), scrub_extraheader(repo)]
    except OSError as error:
        print(f"scrub-remote: {error.__class__.__name__}, left as is", file=sys.stderr)
        return 0
    said = [c for c in clauses if c]
    if said:
        report("scrub-remote: " + ", ".join(said))
    return 0


if __name__ == "__main__":
    sys.exit(main())
