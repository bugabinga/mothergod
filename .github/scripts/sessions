#!/usr/bin/env python3
"""Query the session table: one row per agent run, answered in SQL (ADR-0060).

Extensionless and executable because agents type it mid-session, like inbox,
retrospect and stalled-prs. Any question about runs over time, the operator's
or the director's own, is a verb here, never a hand-assembled artifact walk.

    A READ THIS CANNOT PERFORM PRINTS UNREADABLE AND EXITS NON-ZERO,
    NEVER AN EMPTY TABLE.

An empty table is a finding ("no reviewer run was denied a tool this week");
an unreadable one that prints as empty is the same finding, false, with
nothing recording the miss. inbox and security-alerts carry the same
contract for the same reason.

Verbs:

    sql <statement> [param ...]   any statement; rows as one aligned table
    roles [--since 7d|DATE]       per role over the window: runs, measured,
                                  median and max turns, output tokens,
                                  denials, errors, no-op runs over the runs
                                  with writes recorded, projected cost
    show <run-id>                 one run's row, one field per line
    migrate                       apply infra/sessions/schema.sql one statement
                                  at a time and name what the database lacked;
                                  a column already present is skipped, not an
                                  error
    backfill [--since 7d|DATE]    migrate, then one row per archived audit
             [--rebuild]          artifact the table lacks, `at` the artifact's
                                  creation, with its allowance readings, tool
                                  counts and walls beside it, eight runs a
                                  call; prints the census and exits non-zero
                                  on a gap. A statement that created a table
                                  or added a column makes the walk whole,
                                  present rows too: how a derived table gets
                                  its history, no hand needed (#1355).
                                  --rebuild forces that walk

The table holds identifiers and API-authored numbers only (schema.sql names
each column); a run's prose stays in its audit artifact for 90 days, linked
by run id. The live row is written by session-row.py as each run ends;
`backfill`, which agent-model-intel.yml runs every Sunday, writes the rows
the archive holds and the table does not, keyed from the artifact's name so
a present row costs no download, and then counts: every artifact the
listing returned must have a row, or the verb names the ones without and
exits 1. A partial backfill that reads as done is the same lie an empty
table is.

Reads CLOUDFLARE_API_TOKEN; the database is named once in d1.py. `backfill`
also reads GITHUB_REPOSITORY, or `--repo owner/name`.

Usage: sessions sql <statement> [param ...] | roles [--since W] | show <run-id> | migrate | backfill [--since W] [--rebuild] [--repo R]
"""

import os
import re
import sys
from datetime import datetime, timedelta, timezone

import audit_facts
import d1
from trend import summarize_roles

SCHEMA = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                      "..", "..", "infra", "sessions", "schema.sql")


def cell(value):
    if value is None:
        return ""
    if isinstance(value, float):
        return f"{value:.2f}"
    return str(value)


def render(rows):
    """Rows as one aligned table: header, rule, one line per row.

    Columns are the first row's keys in the order the statement produced
    them, so `SELECT a, b` prints a then b. No rows prints the one line that
    says so, which is a finding and not a failure.
    """
    if not rows:
        return ["(no rows)"]
    columns = list(rows[0].keys())
    table = [[cell(r.get(c)) for c in columns] for r in rows]
    widths = [max(len(c), *(len(t[i]) for t in table)) for i, c in enumerate(columns)]
    line = lambda cells: "  ".join(v.ljust(w) for v, w in zip(cells, widths)).rstrip()
    return [line(columns), line(["-" * w for w in widths]), *(line(t) for t in table)]


def render_show(rows, run_id):
    if not rows:
        return [f"no session with run id {run_id}"]
    width = max(len(k) for k in rows[0])
    return [f"{k.ljust(width)}  {cell(v)}" for k, v in rows[0].items()]


class Usage(Exception):
    """A flag without its value: the usage line and exit 2, like an unknown verb."""


def flag(args, name):
    """The value after `name` in `args`, or None when the flag is absent."""
    if name not in args:
        return None
    at = args.index(name) + 1
    if at == len(args):
        raise Usage(name)
    return args[at]


def stamp(when):
    """A UTC instant in the shape the `at` column holds, year zero-padded.

    `%Y` does not pad on glibc, so year 1 printed as `1-01-01T00:00:00Z`,
    and `at >= ?` compares strings: that one sorts before every four-digit
    year and the window reads empty instead of whole (#1203).
    """
    return f"{when.year:04d}" + when.strftime("-%m-%dT%H:%M:%SZ")


def since_of(spec, now):
    """`7d` style windows and ISO dates both become a UTC instant."""
    usage = f"sessions: --since takes Nd or an ISO date, not {spec!r}"
    match = re.fullmatch(r"(\d+)d", spec)
    if match:
        # Two overflows, one answer: `timedelta` refuses a day count past a C
        # int, and the subtraction refuses a result before year 1 (#1003).
        try:
            return now - timedelta(days=int(match.group(1)))
        except OverflowError:
            raise SystemExit(usage)
    # A third overflow: `fromisoformat` accepts year 1 and year 9999 with a
    # zone, and the shift to UTC then leaves the calendar (#1029).
    try:
        when = datetime.fromisoformat(spec.replace("Z", "+00:00"))
        # A date with no zone is UTC midnight: the table and the archive are
        # stamped in UTC, and `astimezone` on a naive value would read the
        # machine's clock.
        if when.tzinfo is None:
            when = when.replace(tzinfo=timezone.utc)
        return when.astimezone(timezone.utc)
    except (ValueError, OverflowError):
        raise SystemExit(usage)


# An artifact's name as agent-audit builds it, `audit-<role>-<run id>-<attempt>`.
# Artifacts named before #891 slice 2b carry an allowance suffix the worker's
# /budget once read from the listing; it is tolerated until they expire. The
# table's key is (run_id, attempt), so the listing alone says which rows are
# present and the walk downloads only the rest.
NAME = re.compile(r"^audit-[a-z-]+-(\d+)-(\d+)(?:-u\d+-r\d+)?$")


def statements(text):
    """The schema file's statements in file order, `--` comments stripped first.

    Stripped first because a comment may hold a `;` (the header's does), and
    the file has no string literal that holds `--`.
    """
    bare = "\n".join(line.split("--", 1)[0] for line in text.splitlines())
    return [s.strip() for s in bare.split(";") if s.strip()]


def schema():
    with open(SCHEMA, encoding="utf-8") as fh:
        return fh.read()


TABLES = "SELECT name FROM sqlite_master WHERE type = 'table'"
ADDED = re.compile(r"ALTER TABLE (\w+) ADD COLUMN (\w+)", re.IGNORECASE)


def tables():
    return {r["name"] for r in d1.query(TABLES)}


def migrate(text):
    """Apply the schema text one statement at a time; returns what the database lacked.

    One statement per call because an ALTER TABLE ADD COLUMN is not
    idempotent in SQLite: its second run answers "duplicate column name",
    which in a one-batch call would stop every statement after it. Here that
    answer is the column being present, skipped, so the file replays on an
    existing database as its header promises. Any other failure is
    Unreadable, the caller's exit.

    The return names each table the file created, from the table list
    before and after, and each column it added, as `table.column`: a CREATE
    IF NOT EXISTS answers the same either way, so the list is the one read
    that says. `backfill` walks the whole archive when it is not empty,
    which is how a derived table added after the archive began gets its
    history without a hand (#1355).
    """
    before = tables()
    added = []
    for statement in statements(text):
        try:
            d1.query(statement)
        except d1.Unreadable as error:
            if (statement.upper().startswith("ALTER TABLE")
                    and "duplicate column" in str(error).lower()):
                continue
            raise
        match = ADDED.match(statement)
        if match:
            added.append(".".join(match.groups()))
    return sorted(tables() - before) + added


def key_of(name):
    match = NAME.match(name)
    return (int(match.group(1)), int(match.group(2))) if match else None


def keys_in_table():
    return {(r["run_id"], r["attempt"])
            for r in d1.query("SELECT run_id, attempt FROM sessions")}


# Runs per write call. The archive held 1,773 artifacts on 2026-10-09 and
# the API allows 1,200 calls per five minutes, which a whole walk at one
# run per call reaches in four minutes at the 0.17 s a call measured on
# 2026-10-18; at eight runs a call the walk is some 225 calls, under a
# minute of writes. D1's limits are per statement inside a call (100 KB
# of text, where a run's largest statement is its tools insert at a few
# kilobytes) and 30 s for the call, so eight is pacing, not a ceiling.
RUNS_PER_CALL = 8


def backfill(repo, since, rebuild=False):
    """Migrate, write the archive's rows the table lacks, print the census; 1 on a gap.

    The schema goes first, so a table or column merged during the week
    exists before the walk writes it, and a statement that created or added
    one makes the walk whole, as `rebuild` does by hand: every artifact,
    present rows included, which is how a derived table gets its history
    (#1355). The allowance, tools and walls tables each got theirs by a
    hand migrate and a hand rebuild, three times the same two steps.

    Oldest first, as `archive` lists them, so a walk that dies midway has
    written what the 90-day expiry was about to take. Idempotent: a second
    run finds every row present and downloads nothing. Each artifact's
    allowance readings, tool counts and walls precede its session row in
    one script, from the same download, in audit_facts.script's order, and
    RUNS_PER_CALL scripts ride one call; the census stays on sessions,
    because a run that reported no reading has no allowance row to count,
    and because the session row, written last, marks its derived rows in:
    a call that fails midway leaves each run in it whole or absent for the
    next walk, never present without them (#1102).

    The table is read once either way, so the census's `present` counts
    the rows it held before the walk; deriving it from the walk printed
    `present 0` over a full table on that very rebuild (#1012).
    """
    new = migrate(schema())
    rebuild = rebuild or bool(new)
    present = keys_in_table()
    artifacts = audit_facts.archive(repo, since)
    keys = {a.name: key_of(a.name) for a in artifacts}
    todo = artifacts if rebuild else [a for a in artifacts if keys[a.name] not in present]
    # Counted here, before the walk rewrites `keys` from each artifact's
    # metadata: the census answers what the table held when the walk began,
    # keyed by name like `todo` (#1016).
    held = sum(key in present for key in keys.values())
    written, unreadable = 0, []
    pending = []  # (name, key, script) of the runs the next call writes

    def flush():
        nonlocal written
        d1.query(";\n".join(text for _, _, text in pending))
        for name, key, _ in pending:
            keys[name] = key
        written += len(pending)
        pending.clear()

    for read in audit_facts.walk(repo, todo):
        if read.error:
            unreadable.append(f"{read.artifact.name}: {read.error}")
            continue
        # One artifact costs one unreadable line, never the walk (the
        # invariant on audit_facts.walk): a field of the wrong shape raises
        # inside row(), and naming the exception types one hostile shape at a
        # time missed three times (#995 rounds 3 to 5).
        try:
            values = audit_facts.row(read.meta, read.sizes.get)
            readings = audit_facts.allowance_rows(read.meta)
            tool_rows = audit_facts.tools_rows(read.meta)
            wall_rows = audit_facts.walls_rows(read.meta)
            text = audit_facts.script(values, readings, tool_rows, wall_rows)
        except Exception as error:  # noqa: BLE001, the invariant above
            unreadable.append(f"{read.artifact.name}: metadata has a malformed field "
                              f"({type(error).__name__}: {error})")
            continue
        if values[0] is None:
            unreadable.append(f"{read.artifact.name}: metadata carries no run_id")
            continue
        pending.append((read.artifact.name, (values[0], values[1]), text))
        if len(pending) == RUNS_PER_CALL:
            flush()
    if pending:
        flush()
    have = keys_in_table()
    missing = [name for name, key in keys.items() if key not in have]
    for line in unreadable:
        print(f"  unreadable {line}")
    floor = stamp(artifacts[0].made) if artifacts else "none"
    print(f"sessions backfill: schema new {', '.join(new) or 'none'}"
          f" | artifacts {len(artifacts)} since {floor}"
          f" | present {held} | written {written}"
          f" | unreadable {len(unreadable)} | missing {len(missing)}")
    return 1 if missing else 0


def unreadable(error):
    print(f"sessions: UNREADABLE: {error}")
    return 1


def main(argv):
    verb = argv[1] if len(argv) > 1 else ""
    args = argv[2:]
    try:
        if verb == "sql" and args:
            rows = d1.query(args[0], args[1:])
            print("\n".join(render(rows)))
        elif verb == "roles":
            spec = flag(args, "--since") or "7d"
            since = stamp(since_of(spec, datetime.now(timezone.utc)))
            rows = d1.query("SELECT role, measured, turns, out_tokens, denials, error, "
                            "cost_usd, writes FROM sessions WHERE at >= ?", [since])
            print(f"sessions since {since}: {len(rows)}")
            print("\n".join(render(summarize_roles(rows))))
        elif verb == "show" and len(args) == 1:
            rows = d1.query("SELECT * FROM sessions WHERE run_id = ? ORDER BY attempt DESC LIMIT 1",
                            [int(args[0])])
            print("\n".join(render_show(rows, args[0])))
        elif verb == "migrate":
            new = migrate(schema())
            print(f"sessions: schema applied from {os.path.relpath(SCHEMA)}: "
                  f"new {', '.join(new) or 'none'}")
        elif verb == "backfill":
            spec = flag(args, "--since")
            since = since_of(spec, datetime.now(timezone.utc)) if spec else None
            repo = flag(args, "--repo") or os.environ.get("GITHUB_REPOSITORY")
            if not repo:
                print("sessions: backfill needs GITHUB_REPOSITORY or --repo owner/name")
                return 2
            return backfill(repo, since, rebuild="--rebuild" in args)
        else:
            print(__doc__.strip().splitlines()[-1])
            return 2
    except Usage as error:
        print(f"sessions: {error} takes a value")
        print(__doc__.strip().splitlines()[-1])
        return 2
    except (d1.Unreadable, audit_facts.Unreadable) as error:
        return unreadable(error)
    except OSError as error:
        return unreadable(error)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
