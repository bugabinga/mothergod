#!/usr/bin/env python3
r"""Deny a review session's write aimed at any PR but the one it reviews (PreToolUse hook).

agent-review.yml hands the reviewer its PR as `PR_NUMBER` in the step
environment, because a `${{ }}` in the prompt would cap the whole prompt
at 21,000 characters (issue #154), and the model resolves it. Run
36178330703 was scoped to PR #768 and resolved to #770 instead, the
newest of three open PRs: it reviewed #770, passed it, merged it 27
seconds after #770's own reviewer had failed it, then ended green on
#768 with no verdict ever posted there (issue #771). Nothing checked
that the actions landed where the environment pointed. This does.

Threat model: a wrong resolution, not an evader. A model that means to
write elsewhere holds the token and the shell, and no matcher on the
Bash boundary stops it; this hook makes the mistake cost one turn and a
message instead of a merge. It is judged against the ordinary shapes a
wrong number reaches a write verb through, and PR #772's three review
rounds each found one (a bare newline, a variable, a rebound
`PR_NUMBER`, a subshell and an xargs feed), so the rules below are
shaped to close a class each rather than a case. `eval`, indirection through a second variable, and
the like are out of scope by decision (BDFL, PR #772).

Armed only when `PR_NUMBER` is a number in the environment, which is
agent-review.yml's Claude step and nothing else. Denied, per shell
segment (split on `;`, `&`, `|` and newline, because the Bash tool
carries multi-line commands):
- a write verb, every occurrence, whose first positional number is not
  `PR_NUMBER`;
- a write verb whose target is a shell variable other than
  `$PR_NUMBER`, quoted or bare (`merge-pr $n`, `gh pr merge "$TARGET"`),
  or arrives through an xargs feed (`echo 770 | xargs merge-pr`,
  `... | xargs -I{} merge-pr {}`): the hook cannot read it, so it denies
  rather than reading the absence of a literal digit as safe. A body
  piped into `gh-comment 768` or `push-branch <branch>` carries its
  target on the line and passes;
- a command that carries a write verb and names `PR_NUMBER` without
  `$`, in any position or quoting: every way a shell rebinds a variable
  names it bare (`PR_NUMBER=770 merge-pr $PR_NUMBER`,
  `export "PR_NUMBER=770"`, `read PR_NUMBER`), so one token pattern
  covers every form, and the hook trusts `$PR_NUMBER` only because the
  workflow set it.
The write verbs are the ones a verdict is made of: `merge-pr`,
`gh-comment`, `push-branch`, the mutating `gh pr` and `gh issue`
subcommands, and `gh api` on `/issues/<n>` or `/pulls/<n>` with a write
marker (`-X`/`--method` with a mutating method, or a field flag, which
makes gh POST). Reads stay allowed whatever number they name (`gh pr
view|diff|checks|list|checkout`, `gh issue view`, a bare `gh api` GET),
as does a number inside quoted prose (`--body "supersedes #770"`); only
a quoted span that is nothing but digits or one variable counts as a
target, because `merge-pr "770"` and `merge-pr "$n"` run exactly like
their bare forms. A write verb with no number and no variable in sight
(`push-branch <branch>` before a PR exists, `gh-comment --new`) has
nothing to verify against and passes.

Contract: reads the PreToolUse JSON on stdin. Every other seat, a
malformed JSON, a null tool_input (the #324 shape) and any tool but Bash
are allowed through. Exit 2 denies; stderr names both numbers and the
next step, so a wrong resolution costs one turn instead of a merge.

Liveness: every deny appends a fixed-vocabulary line to
GITHUB_STEP_SUMMARY, and the test file pins agent-review.yml's
`PR_NUMBER` env line, so renaming the variable breaks the test rather
than silently disarming the guard.
"""

import json
import os
import re
import sys

QUOTED = re.compile(r"'[^']*'|\"[^\"]*\"")

# A newline separates statements exactly as `;` does.
SEGMENT = re.compile(r"[;&|\r\n]+")

# A number token: not glued to a path, a word, a flag value like `-770`,
# or an issue reference like `#770` in prose.
NUMBER = r"(?<![\w/.#=-])(\d+)(?![\w.-])"

# A shell variable or brace expansion: `$n`, `$TARGET`, `${PR_NUMBER}`.
VARIABLE = re.compile(r"\$\{?(\w+)\}?")

# `PR_NUMBER` named bare: not `$PR_NUMBER`, not `${PR_NUMBER}`, not part
# of a longer word. Matched on the raw command, quotes included, because
# `export "PR_NUMBER=770"` rebinds exactly like the unquoted form.
REBIND = re.compile(r"(?<![${\w])PR_NUMBER\b")

# (class name for the summary line, verb pattern). The target is the
# first number token after the verb in the same segment. A script verb
# is recognized wherever a shell word starts, `(merge-pr 770)`, a
# backtick capture, `$(...)`, not only after whitespace or a slash.
VERBS = (
    ("merge-pr", re.compile(r"(?<![\w.-])merge-pr\b")),
    ("gh-comment", re.compile(r"(?<![\w.-])gh-comment\b")),
    ("push-branch", re.compile(r"(?<![\w.-])push-branch\b")),
    (
        "gh pr write",
        re.compile(
            r"\bgh\s+pr\s+(?:edit|merge|close|reopen|ready|review|comment|"
            r"lock|unlock)\b"
        ),
    ),
    (
        "gh issue write",
        re.compile(
            r"\bgh\s+issue\s+(?:edit|close|reopen|comment|lock|unlock|delete|"
            r"pin|unpin|transfer)\b"
        ),
    ),
)

GH_API = re.compile(r"\bgh\s+api\b")
API_WRITE = re.compile(
    r"(?:-X|--method)[\s=]+(?:POST|PATCH|PUT|DELETE)\b"
    r"|(?:^|\s)(?:-[fF]|--field|--raw-field|--input)\b"
)
API_TARGET = re.compile(r"/(?:issues|pulls)/([^\s/\"']+)")

# The verb's arguments arrive from a pipe: `echo 770 | xargs merge-pr`,
# `... | xargs -I{} merge-pr {}`. Nothing on the line to verify.
FEED = re.compile(r"\bxargs\b")
PLACEHOLDER = "{}"

# `other` in a denial is a literal number, or one of these two.
UNRESOLVED = "unresolved"
REBOUND = "rebound"

MESSAGE = (
    "This run reviews #{pr}; the command targets #{other}. A verdict, "
    "label, comment or merge on any other PR from here is a review that "
    "never reached #{pr} and a green check that lies: the run for #768 "
    "merged #770 that way (#771). #{other} has its own review run. "
    "Resolve the number again with `echo $PR_NUMBER` and act on that PR "
    "only."
)

UNRESOLVED_MESSAGE = (
    "This run reviews #{pr}; the {verb} target here is a shell variable, "
    "a substitution or an xargs feed, not a literal number on the line, "
    "so this hook cannot verify it is #{pr}. That is exactly how the run "
    "for #768 merged #770 (#771): the number lived off the line. Resolve "
    "the number with `echo $PR_NUMBER` and write it literally, or use "
    "`$PR_NUMBER` verbatim, before this write."
)

REBOUND_MESSAGE = (
    "This run reviews #{pr}, and this hook trusts `$PR_NUMBER` only "
    "because the workflow set it. This command names PR_NUMBER without "
    "`$` next to a {verb}: that is how a shell rebinds it "
    "(`PR_NUMBER=770 ...`, `export PR_NUMBER=...`), and the hook cannot "
    "see the value it would take. Use `$PR_NUMBER` verbatim, or read it "
    "with `echo $PR_NUMBER` and write the number literally. Prose that "
    "names PR_NUMBER goes in a file first: `gh-comment {pr} < body.md`."
)

SUMMARY_TARGET = {
    UNRESOLVED: "an unresolved target",
    REBOUND: "a rebound PR_NUMBER",
}


def strip_prose(command: str) -> str:
    """A quoted span that is only digits, or one double-quoted variable,
    is a target and unwraps; any other quoted span is an argument, never
    a target, and collapses to `q`."""

    def rewrite(match: re.Match[str]) -> str:
        span = match.group(0)
        content = span[1:-1]
        if content.isdigit():
            return content
        if span[0] == '"' and VARIABLE.fullmatch(content):
            return content
        return "q"

    return QUOTED.sub(rewrite, command)


def first_write(stripped: str) -> str | None:
    """The class name of the first write verb in the command, or None."""
    for name, verb in VERBS:
        if verb.search(stripped):
            return name
    if GH_API.search(stripped) and API_WRITE.search(stripped):
        return "gh api write"
    return None


def other_target(command: str, pr: str) -> tuple[str, str] | None:
    """The (class, number) of the first write aimed off the PR, or None.

    `number` is UNRESOLVED when a write verb's target is a shell
    variable other than `$PR_NUMBER`, and REBOUND when the command
    names `PR_NUMBER` bare beside a write verb: in both the hook cannot
    verify the target, so it denies rather than reading what it cannot
    see as safe."""
    stripped = strip_prose(command)
    name = first_write(stripped)
    if name is None:
        return None
    if REBIND.search(command):
        return name, REBOUND
    for segment in SEGMENT.split(stripped):
        for name, verb in VERBS:
            for hit in verb.finditer(segment):
                rest = segment[hit.end():]
                number = re.search(NUMBER, rest)
                if number is not None:
                    if number.group(1) != pr:
                        return name, number.group(1)
                    continue
                variable = VARIABLE.search(rest)
                if variable is not None and variable.group(1) != "PR_NUMBER":
                    return name, UNRESOLVED
                if variable is None and (
                    FEED.search(segment[: hit.start()]) or PLACEHOLDER in rest
                ):
                    return name, UNRESOLVED
        if GH_API.search(segment) and API_WRITE.search(segment):
            for target in API_TARGET.finditer(segment):
                value = target.group(1)
                if value.isdigit():
                    if value != pr:
                        return "gh api write", value
                elif value not in ("$PR_NUMBER", "${PR_NUMBER}"):
                    return "gh api write", UNRESOLVED
    return None


def main() -> int:
    """Allow (0) or deny (2) the tool call described on stdin."""
    pr = os.environ.get("PR_NUMBER", "")
    if not pr.isdigit():
        return 0
    try:
        call = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    if call.get("tool_name") != "Bash":
        return 0
    tool_input = call.get("tool_input")
    if not isinstance(tool_input, dict):
        return 0
    command = tool_input.get("command")
    if not isinstance(command, str):
        return 0
    found = other_target(command, pr)
    if found is None:
        return 0
    name, other = found
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        target = SUMMARY_TARGET.get(other, f"#{other}")
        with open(summary, "a", encoding="utf-8") as fh:
            fh.write(f"deny-other-pr: denied {name} on {target}\n")
    if other == REBOUND:
        print(REBOUND_MESSAGE.format(pr=pr, verb=name), file=sys.stderr)
    elif other == UNRESOLVED:
        print(UNRESOLVED_MESSAGE.format(pr=pr, verb=name), file=sys.stderr)
    else:
        print(MESSAGE.format(pr=pr, other=other), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
