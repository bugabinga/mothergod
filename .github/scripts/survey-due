#!/usr/bin/env python3
"""Answer whether this wake owes the weekly deep survey, and say what decided.

Extensionless and executable because agents type it as a command mid-session,
like operator-sweep, retrospect, stalled-prs and security-alerts.

The SURVEY wake condition used to be a sentence: "a scheduled Sunday wake
where the ops-log has no deep-survey digest dated that Sunday yet". A model
evaluated it by reading issue #3's prose by eye, matching a digest heading
against a skill name. On 2026-09-13 one did not: the survey had run at
00:38:19Z, and the 12:31:56Z digest told the operator this week had no survey
and announced skipping it for budget. The run reported a sacrifice it had not
made, because nothing could tell it the duty was already done (#558).

Every other per-run duty was compiled for exactly this reason: operator-sweep
(#147), stalled-prs (#377), retrospect, security-alerts (#555). The survey's
trigger was the last prose detector left, guarding the most expensive duty.

Three conditions decide, and this reads all three:

    the wake       TRIGGER_EVENT, when the environment sets it. A scheduled
                   wake carries the survey. Unset means somebody asked the
                   question by hand, which is always a fair question. Any
                   other value is an operator wake, which never carries it.
    the marker     an HTML comment the deep-survey skill's completion gate
                   emits into its digest on the ops-log issue:

                       <!-- deep-survey 2026-09-13 -->

    the day        two clauses; the first that fires decides, and the
                   footer names it:

                   Sunday clause      today is a Sunday in UTC and no marker
                                      carries today's date. The cadence is
                                      weekly and the ops log is timestamped
                                      in UTC, so the week boundary is UTC's;
                                      Sunday is the day the Saturday and
                                      Sunday ledgers (docs-watch,
                                      traffic-snapshot, model-intel,
                                      coverage-check) are arranged around.
                   seventh-day        the newest marker is PERIOD_DAYS or
                   clause             more days old, or none is readable.

The seventh-day clause heals a shed Sunday on Monday. The Sunday clause alone
keyed on the calendar: both 2026-09-27 wakes read due and shed the survey
under SLOW DOWN, every wake from Monday on read not-due by the clock, and the
week of 2026-09-21 was never surveyed (#910). A survey that heals on Monday
carries Monday's date, and the next Sunday is due again by the Sunday clause,
so the anchor holds and the heal costs one short week, once.

The marker is an HTML comment and not the digest's prose heading, because a
heading is written fresh by a different model every week and the one thing a
detector cannot survive is being rephrased. It carries its own date rather
than relying on the comment's `created_at`: the 00:38Z digest that started
this shows a survey can cross midnight, and the survey a digest reports is the
one it says it is. On a healed week that date is the survey's own weekday.

Deliberately NOT read, said plainly so nothing claims a completeness it lacks.
The Telegram inbox makes a scheduled wake a CHAT wake, and a CHAT wake never
carries the survey because reply latency outranks it. That state lives in
Cloudflare KV, this reads GitHub, and drain order means the caller knows the
answer before it runs this. The prompt keeps that clause.

The invariant that matters more than any line it prints:

    AN OPS LOG THIS CANNOT READ ANSWERS DUE, NEVER RAN.

The two failures are not symmetric. Answering DUE wrongly costs one duplicated
survey, in the open, and the next marker ends it. Answering RAN wrongly skips
the week's most expensive duty silently, which is the exact bug this script
exists to end, and the bug leaves no trace but an absence nobody is looking
for. So an unreadable ops log, a missing marker and a malformed marker all
answer DUE.

Liveness: the footer always names the day it tested, the newest marker it
found, whether the ops log read, and how many markers it saw, so a reader can
tell a survey that has not happened from a detector that has silently stopped
working.

Usage: survey-due

Exits 0 whichever way it answers. A due survey is a duty, not an error.
"""

import json
import os
import re
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone

# The ops-log issue (CLAUDE.md "Where things live"). The survey's digest is
# posted here, so this is where the marker lives.
OPS_LOG = 3

# Matches the marker the deep-survey skill's completion gate emits. Tolerant
# of inner whitespace because a markdown editor may reflow it, strict about
# the date because the date is the whole payload.
MARKER = re.compile(r"<!--\s*deep-survey\s+(\d{4}-\d{2}-\d{2})\s*-->")

SUNDAY = 6  # datetime.weekday(): Monday is 0.

PERIOD_DAYS = 7  # weekly means the seventh day, as herald-survey-due counts it.

# How far back the ops log is read. A marker dated PERIOD_DAYS ago whose
# digest crossed midnight was posted one day later, so this window shows the
# footer the newest marker on the day the seventh-day clause first fires.
# Anything older answers due either way; reading it would buy only a longer
# footer, at a page of the ops log per day.
READ_DAYS = PERIOD_DAYS + 1


def comments(repo, since):
    """Read the ops-log comments posted since `since`. Returns (rows, reason).

    Never dies. An unreadable ops log is a finding this renders as DUE, not an
    exit code, so it is returned as data like security-alerts does with a 403.

    Not `anchor.gh`, which dies on failure: dying here would answer neither
    DUE nor RAN, and a caller that gets no answer falls back to reading the
    prose by eye, which is the failure mode (#558). Not security-alerts' own
    reader either: that one swaps in GH_WORKFLOW_TOKEN for the security scopes
    the app token lacks, and issue comments need no such widening.

    `since` bounds the read to READ_DAYS. The ops log is append-only and years
    long; paginating all of it to find a marker at most a week old would make
    this the slowest duty in a run that has four.

    No `--jq`. `gh api --paginate --jq` prints one JSON document per line,
    which `json.loads` cannot take (the crash stalled-prs.test.mjs records
    from PR #490). Bare `--paginate` merges array pages into one array.
    """
    proc = subprocess.run(
        ["gh", "api", "--paginate", f"repos/{repo}/issues/{OPS_LOG}/comments?since={since}&per_page=100"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        reason = proc.stderr.strip().splitlines()
        return None, (reason[-1] if reason else f"gh exited {proc.returncode}")
    try:
        return json.loads(proc.stdout), None
    except json.JSONDecodeError:
        return None, "response was not JSON"


def newest(rows, today):
    """The marker with the latest date on or before `today`, as (date, row), or None.

    Reads the marker's own date, not the comment's `created_at`: a survey that
    starts Sunday evening posts its digest on Monday, and the survey it
    reports is still Sunday's.

    A marker whose date is not a day (2026-13-40) matches the regex and is
    dropped; so is one dated after today, which no survey can have produced.
    Dropping rather than dying keeps the invariant: fewer markers can only
    move the answer toward DUE, the safe direction.
    """
    best = None
    for row in rows:
        for found in MARKER.findall(row.get("body") or ""):
            try:
                when = date.fromisoformat(found)
            except ValueError:
                continue
            if when > today:
                continue
            if best is None or when > best[0]:
                best = (when, row)
    return best


def render(today, trigger, rows, error, out=sys.stdout):
    """Print the verdict and the liveness footer. Returns the footer.

    `today` is a `date`. Pure by construction: no clock, no network, so the
    tests can hand it every day of the week.
    """
    hit = None
    if trigger is not None and trigger != "schedule":
        verdict, detail = "not-due", f"wake is {trigger}, not schedule"
    elif error is not None:
        verdict, detail = "due", "ops log UNREADABLE, which is not the same as no survey"
    else:
        hit = newest(rows, today)
        age = None if hit is None else (today - hit[0]).days
        if today.weekday() == SUNDAY and age != 0:
            verdict, detail = "due", "Sunday clause: no deep-survey marker dated today"
        elif hit is None:
            verdict, detail = "due", f"seventh-day clause: no deep-survey marker in the {READ_DAYS} days read"
        elif age >= PERIOD_DAYS:
            verdict, detail = "due", f"seventh-day clause: newest marker {hit[0]} is {age} days old"
        else:
            verdict, detail = f"ran {hit[1]['created_at']}", hit[1]["html_url"]

    if verdict == "due":
        print(f"\nsurvey: DUE on {today:%A} {today}. {detail}.", file=out)
        if error is not None:
            print(f"    {error}", file=out)
            print(
                "    Reading the ops log by eye is what this replaced."
                " Re-run once, then treat the survey as due.",
                file=out,
            )
        print(
            "    Run the delta core in full first, then the `deep-survey` skill.",
            file=out,
        )

    # Read state comes from the read, never from the conditions that led to
    # it: an operator wake never touched the ops log, and printing `readable`
    # for a read that did not happen is the kind of manufactured reassurance
    # the UNREADABLE invariant above exists to refuse.
    if error is not None:
        state = "unreadable"
    elif rows is None:
        state = "unread"
    else:
        state = "readable"
    markers = "-" if rows is None else sum(
        1 for row in rows if MARKER.search(row.get("body") or "")
    )
    # Every verdict carries its reason on the footer line, including the two
    # quiet ones. A bare `not-due` sends the reader back to the clock and the
    # trigger to reconstruct which of them decided, and reconstructing the
    # condition by hand is what this script replaced.
    footer = (
        f"survey-due: {verdict} ({detail})"
        f" | today {today} {today:%a}"
        f" | newest {hit[0] if hit else '-'}"
        f" | ops-log {state}"
        f" | markers {markers}"
    )
    print(f"\n{footer}", file=out)
    return footer


def main():
    repo = os.environ.get("GITHUB_REPOSITORY", "bugabinga/mothergod")
    today = datetime.now(timezone.utc).date()
    trigger = os.environ.get("TRIGGER_EVENT") or None

    # Every scheduled wake pays one read, because the seventh-day clause can
    # fire on any weekday. An operator wake answers from the trigger alone.
    rows, error = (None, None)
    if trigger is None or trigger == "schedule":
        since = f"{today - timedelta(days=READ_DAYS)}T00:00:00Z"
        rows, error = comments(repo, since)

    render(today, trigger, rows, error)


if __name__ == "__main__":
    main()
