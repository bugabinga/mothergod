#!/usr/bin/env python3
"""Judge every agent session since the previous run, and say what budget is left.

Extensionless and executable because agents type it as a command mid-session,
like operator-sweep, push-branch and settle-push.

The BDFL's retrospect duty judges each finished session on four things: right
result, sane turn count, token-lean output, correct altitude and voice. Three
of those are numbers in the audit artifact every run uploads (ADR-0023) and
the fourth is the response text beside them, so the reading is mechanical and
was being hand-assembled every wake: list runs, download N artifacts, parse
JSON, tabulate. That is hot work on a hard substrate, which is the ADR-0022
test for compiling it.

It also produced a wrong reading on its first outing. `permission_denials` is
`{"count": N, "tools": [...]}`, not a list; taking its length by hand reports
2 denials for every session that had none, and "every agent is being denied
something" is exactly the kind of false alarm a retrospect exists to avoid.
The parse lives here now, once, where it can be wrong at most once.

BUDGET is the second half, and it rides free. Every artifact carries the
session's `rate_limit_events`, each carrying allowance-window utilization
and reset instants in one of two shapes (the parse is `allowance.py`,
shared with the artifact-naming index). Nothing in this project read them:
the pause
machinery keys on `status == "rejected"` (ADR-0018), which fires when the
factory has ALREADY stopped for up to a week. Between "fine" and "stopped"
there was no signal at all. These artifacts are downloaded for the audit
regardless, so the number costs nothing extra and appears on every wake.
The verdict it prints is the governor's own projection (`allowance.project`,
ADR-0039), never a second estimate. The footer once ran its own, a
two-reading delta over the audited minutes, and shouted SLOW DOWN at 33%
used with 2.7 of 7 days gone, because a post-pause catch-up burst
extrapolates to a rate the week never sustains; the governor, reading the
same minute, projected 82% and throttled nothing (issue #533). An advisory
that fires on a different rate than the mechanism is a second policy.

ATTRIBUTION is the third reading, and it also rides free. A seat that
posts an issue comment around `gh-comment` loses its role footer, and two
seats did it three days apart with prompt text already forbidding it
(issue #510). The tell is mechanical, author login alone, so it lives as
a predicate in `attribution.py` and its findings print here, beside the
sessions that produced them.

OPENERS is the fourth reading. A final response that begins "Heartbeat
done." spends the notice's first line, the one the operator reads, on the
label the notice already prints last; CLAUDE.md forbids it and a third of
sessions did it anyway. `opener.py` holds the predicate, run-notice.py
drops the opener from the notice, and this flags it beside the session
and counts it in the summary, so the rule's failure rate is a number.

What this does NOT cover, said plainly so nothing claims a completeness it
lacks:

  - runs still in flight, which have uploaded nothing to judge yet. They are
    listed as pending, not silently dropped, and land in a later window.
  - a run the guard skipped (pause, throttle, exhausted ladder), which held
    no session. Counted on one line, never listed: forty of them after an
    outage were once printed as sessions that died, URL each (#525).
  - a run that died before its audit step, which has no artifact. Reported by
    name with its URL, because that is the one case where `gh run view --log`
    still earns its cost.
  - a phantom: a run GitHub raised and never gave a job, concluding `failure`
    in seconds with nothing behind it (#553; a bot-attributed pull_request
    event does this now and then, 33233523131 and 35205833235). Counted on
    one line with its URL, never sent to the log, because there is no log:
    `gh run view --log` answers "log not found", and a BDFL wake spent two
    calls learning that on 2026-09-17.
  - non-agent workflows (ci, CodeQL, the worker tests). Those are graded by
    passing or failing, not by judgement.
  - dollars. `total_cost_usd_notional` is a subscription's shadow price, not
    a bill, and is reported for comparison between roles only.

Windowing: sessions that COMPLETED at or after the anchor, where the anchor is
the start of the previous BDFL run that held a session (anchor.py). A session that finished during that
run's long tail can therefore be judged twice. That is deliberate. Anchoring
on the predecessor's finish instead would leave every session that completed
while it was working covered by nobody, and a second read costs a minute where
a gap costs the finding.

Liveness: the last line always prints how many sessions were read, how many
runs were skipped, how many had no artifact, and the anchor, so a retrospect
that returns nothing forever is distinguishable from a quiet hour.
"""

import argparse
import json
import os
import shutil
import subprocess
import tempfile
from datetime import datetime, timezone

from allowance import WEEK, project, valid_fraction, valid_reset, window_readings
from anchor import STAMP, gh, iso, previous_run_start, stamp_to_dt
from attribution import report as attribution_report
from opener import trim

# Only these produce a judgeable session. Everything else in the repository is
# graded by exit code.
AGENT_PREFIX = "agent-"

# Conclusions with no session behind them: the workflow's own guards decided
# not to run an agent at all.
NOT_A_SESSION = frozenset({"skipped", "cancelled", "neutral"})

# Runs pulled from the API before filtering to the window. The common window
# sits well inside the first fetch; a busy pipeline can breach it (2026-09-02:
# three PRs ping-ponging review rounds put a 4-hour window past 100 runs), and
# a breach refetches once at the deep bound. A breach of the deep bound is
# REPORTED, never silently truncated.
RUN_SCAN = 100
RUN_SCAN_DEEP = 1000

# The one window the governor throttles on (guard-decide.py reads the
# `allowance-state` ledger, which agent-audit writes from this window). The
# other windows inform; only this one carries a verdict, because a verdict
# the governor does not share is the disagreement #533 was about.
GOVERNED = "seven_day"

# Below an hour a reading cannot move a %/h verdict by a full unit, so
# naming its age would be noise; at or above, `used` is visibly a floor.
STALE_HOURS = 1.0

# One response longer than this is cut. The auditor judges altitude and voice,
# and both are legible in the opening; a retrospect that floods the reader's
# context is a retrospect the reader skims.
RESPONSE_CAP = 2500


def run_list(repo, limit):
    """Recent runs, newest first, with the fields the window and table need."""
    return json.loads(
        gh(
            "run", "list", "--repo", repo, "--limit", str(limit),
            "--json", "databaseId,name,event,status,conclusion,"
                      "createdAt,startedAt,updatedAt,url,displayTitle",
        )
    )


def breached(runs, limit, anchor):
    """A full page whose oldest run is still in the window hides older runs."""
    return len(runs) == limit and iso(runs[-1]["updatedAt"]) >= anchor


def in_window(run, anchor):
    """A session is judgeable once it is over, so the window is on completion."""
    return run["status"] == "completed" and iso(run["updatedAt"]) >= anchor


def download(run_id, into):
    """Fetch one run's audit artifact. Returns its directory, or None.

    None is the honest answer for a run that died before uploading; gh's own
    stderr is the diagnosis and the caller prints the URL to go read.
    """
    target = os.path.join(into, str(run_id))
    proc = subprocess.run(
        ["gh", "run", "download", str(run_id), "-D", target],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return None
    for root, _, files in os.walk(target):
        if "metadata.json" in files:
            return root
    return None


def hollow(repo, run_id):
    """Why a run with no artifact held no session, or None when it did and died.

    "skipped": the guard skipped it, every Claude step concluded `skipped`.
    "phantom": GitHub raised the run and scheduled no job at all (#553), so
    there is no step, no session and no log; agent-alarm learned this class
    first and this is the same test, a job count of zero.
    None: a real session that died before its audit step, or a run with no
    Claude step by design (agent-alarm); both stay in the no-artifact list,
    where the URL is the story.

    Asked only about a run with no artifact, so an ordinary window spends no
    extra call.
    """
    jobs = json.loads(
        gh(
            "api", f"repos/{repo}/actions/runs/{run_id}/jobs",
            "--jq", '{jobs: (.jobs | length), claude: [.jobs[].steps[] '
                    '| select(.name | test("claude-code-action")) | .conclusion]}',
        )
    )
    if jobs["jobs"] == 0:
        return "phantom"
    if jobs["claude"] and all(c == "skipped" for c in jobs["claude"]):
        return "skipped"
    return None


def read_session(directory):
    """The two files the duty judges, parsed. Missing fields stay None."""
    with open(os.path.join(directory, "metadata.json"), encoding="utf-8") as fh:
        meta = json.load(fh)
    response_path = os.path.join(directory, "output-response.md")
    response = ""
    if os.path.exists(response_path):
        with open(response_path, encoding="utf-8") as fh:
            response = fh.read()
    return meta, response


def denials(telemetry):
    """`permission_denials` is a summary object, not a list. See the docstring."""
    raw = telemetry.get("permission_denials")
    if isinstance(raw, dict):
        return raw.get("count", 0), [
            t.get("tool_name", t) if isinstance(t, dict) else t
            for t in (raw.get("tools") or [])
        ]
    if isinstance(raw, list):  # older artifacts, before the shape settled
        return len(raw), raw
    return 0, []


def short_model(name):
    """`claude-haiku-4-5-20251001` -> `haiku-4-5`. The date is never the point."""
    trimmed = name.removeprefix("claude-")
    parts = trimmed.split("-")
    if parts and parts[-1].isdigit() and len(parts[-1]) == 8:
        parts = parts[:-1]
    return "-".join(parts)


def describe(run, meta, response):
    """One session as the auditor's four judgements, then what it posted.

    Returns whether the response opened with a completion announcement, the
    voice defect `opener.py` compiles; the flag rides the session line and
    the count rides the summary, so the drift is a number the next survey
    can compare rather than a feeling.
    """
    telemetry = meta.get("telemetry") or {}
    usage = telemetry.get("usage") or {}
    count, tools = denials(telemetry)
    models = "+".join(sorted(short_model(m) for m in (telemetry.get("modelUsage") or {})))
    seconds = round((telemetry.get("duration_ms") or 0) / 1000)
    role = meta.get("role") or "?"
    event = (meta.get("trigger") or {}).get("event") or run["event"]

    flags = []
    if meta.get("is_error"):
        flags.append("ERROR")
    if telemetry.get("api_error_status"):
        flags.append(f"api {telemetry['api_error_status']}")
    if (telemetry.get("stop_reason") or "end_turn") != "end_turn":
        flags.append(f"stop {telemetry['stop_reason']}")
    if count:
        flags.append(f"denied {count} ({', '.join(str(t) for t in tools[:3])})")
    if run["conclusion"] != "success":
        flags.append(run["conclusion"])
    _, opener = trim(response)
    if opener:
        flags.append(f'opener "{opener[0]}"')
    # tg-send swaps these out of the operator's notice, so the session line
    # is where the defect stays visible (deny-em-dash's docstring has the
    # counts that made it a mechanism).
    if (dashes := response.count("\u2014")):
        flags.append(f"em dash x{dashes}")

    print(
        f"\n{iso(run['updatedAt'])}  {role}  {event}  "
        f"turns {telemetry.get('num_turns')}  {seconds}s  "
        f"out {usage.get('output_tokens', 0):,} tok  posted {len(response):,} B  {models}"
        + (f"  [{'; '.join(flags)}]" if flags else "")
    )
    print(f"    {run['url']}")
    body = response.strip() or "(posted nothing)"
    if len(body) > RESPONSE_CAP:
        body = f"{body[:RESPONSE_CAP]}\n[cut, {len(response) - RESPONSE_CAP} more characters]"
    for line in body.splitlines():
        print(f"    {line}")
    return bool(opener)


def governor(observed, resets, used):
    """The governor's verdict on the seven-day window, from the arithmetic it runs.

    `project` is what agent-guard throttles on (ADR-0039). When it returns a
    projection, every seat with a `thrift` block is already on it and the
    clock's discretionary wakes are being skipped; SLOW DOWN here tells the
    seat that is awake anyway to spend like the factory is being throttled,
    because it is. When it returns None the projection reaches the reset and
    nothing is throttled, whatever the last sixteen minutes looked like.
    """
    elapsed = (observed - (resets - WEEK)) / 3600
    remaining = (resets - observed) / 3600
    if elapsed <= 0 or remaining <= 0:
        print("        governor: reading outside its own window; nothing to project.")
        return
    week_average = used / elapsed
    sustainable = max(0.0, 1.0 - used) / remaining
    projection = project(observed, resets, used)
    if projection is None:
        print(
            f"        governor: week-average {week_average:.2%}/h, {sustainable:.2%}/h "
            "reaches the reset; projection reaches the reset, every seat in its normal tier."
        )
        return
    exhausts = datetime.fromtimestamp(projection["exhausts_at"], timezone.utc)
    print(
        f"        governor: week-average {week_average:.2%}/h, {sustainable:.2%}/h "
        f"reaches the reset; projected exhaustion {exhausts.strftime(STAMP)} misses it "
        f"by {(resets - projection['exhausts_at']) / 3600:.1f}h. Thrift tiers on, "
        "discretionary wakes being skipped."
    )
    print("        SLOW DOWN: cut discretionary work, or the pause "
          "machinery stops the factory before the reset.")


def budget(samples, anchor, now=None):
    """What the subscription has left, from the rate-limit events just read.

    `samples` is (when, rate_limit_info) in session order. Each info carries
    one or both allowance windows' utilization and reset instant; the shape
    rule is `allowance.window_readings`, shared with the allowance index.
    Only `valid_fraction` utilizations report a number; `resetsAt` degrades
    to "(no reset time reported)", because a valid fraction still informs
    without it. A window kind whose readings ALL fail validation is named
    below instead of dropped: a healthy sibling window must not make a
    shape change look like a quiet one (issue #310).

    Two rates appear and only one is a verdict. "burned X% over the N min
    audited" is an observation of what the audited sessions cost, printed
    as such; it is the two-reading delta `allowance.project` rejects as a
    projection (#369, #533), and nothing here extrapolates it. The verdict
    is `governor`, on the GOVERNED window only.

    A reading is not a clock. `used` is only ever as-of the event that
    reported it, the last audited session, which on a quiet wake is hours
    back; time-to-reset is arithmetic against the present. Computing the
    latter from the former printed "(2.5h)" for a five-hour window that
    had reset 52 minutes before the run read it. So `now` is the present
    (injected only by the fixtures, which must not move with the clock),
    every span is measured from it, and the two facts are labelled apart:
    a window whose reset has passed reports the closed window instead of
    fake headroom, and a live window read STALE_HOURS or longer ago says `used`
    is a floor, because utilization only grows until the window turns
    over. The governor keeps the observation instant, because its rate is
    `used` over the elapsed that produced it, and it does not run at all
    on a window that already reset: a stale SLOW DOWN throttles a seat
    the guard has already released.
    """
    now = now or datetime.now(timezone.utc)
    print("\nbudget:")
    if not samples:
        print("    no rate-limit events in the window. Either nothing ran long "
              "enough to report one, or the artifact shape changed; check "
              "`.github/actions/agent-audit` before assuming the former.")
        return

    by_type = {}
    unreadable = {}
    for when, info in samples:
        for kind, reading in window_readings(info):
            if valid_fraction(reading.get("utilization")):
                by_type.setdefault(kind, []).append((when, reading))
            else:
                unreadable[kind] = unreadable.get(kind, 0) + 1
    if not by_type:
        print("    rate-limit events present but no readable window "
              "utilization. Treat this as a payload shape change, not a "
              "quiet window: the allowance index and the guard ledger read "
              "the same events through allowance.py, so the whole budget "
              "chain is blind until it learns the new shape.")
        return

    for kind, series in sorted(by_type.items()):
        series.sort(key=lambda pair: pair[0])
        first_when, first = series[0]
        last_when, last = series[-1]
        used = last["utilization"]
        left = max(0.0, 1.0 - used)
        line = f"    {kind}: {used:.0%} used, {left:.0%} left"

        resets_at = last.get("resetsAt")
        if not valid_reset(resets_at):
            print(line + " (no reset time reported)")
            continue

        reset = datetime.fromtimestamp(resets_at, timezone.utc)
        observed = stamp_to_dt(last_when)
        hours = (reset - now).total_seconds() / 3600
        age = (now - observed).total_seconds() / 3600
        if hours <= 0:
            print(f"    {kind}: reset {reset.strftime(STAMP)}, {-hours:.1f}h ago; "
                  f"the last reading ({used:.0%} used, at {observed.strftime(STAMP)}) "
                  "describes the window that closed.")
            continue

        minutes = (observed - stamp_to_dt(first_when)).total_seconds() / 60
        burned = used - first["utilization"]
        # A negative delta means the window reset mid-audit; the observation
        # has no meaning then and is dropped, the verdict below still stands.
        observation = (
            f"; burned {burned:.1%} over the {minutes:.0f} min audited"
            if minutes > 0 and burned >= 0 else ""
        )
        staleness = f"; reading {age:.1f}h old, so used is a floor" if age >= STALE_HOURS else ""
        print(f"{line}, resets {reset.strftime(STAMP)} ({hours:.1f}h){staleness}{observation}")
        if last.get("isUsingOverage"):
            print("        on overage: past the included allowance already.")
        if kind == GOVERNED:
            governor(observed.timestamp(), resets_at, used)

    for kind in sorted(set(unreadable) - set(by_type)):
        print(f"    {kind}: present in {unreadable[kind]} event(s), none "
              "readable. A payload shape change for this window, not a "
              "quiet one; the allowance index reads the same parse, so "
              "teach allowance.py the new shape.")


def main():
    parser = argparse.ArgumentParser(
        description="Every agent session since the previous BDFL run, judged, plus what budget is left.",
        epilog="Exit is 0 for a quiet window. Non-zero means this tool failed, not that nothing ran.",
    )
    parser.add_argument("--since", help="ISO8601 anchor; default is the previous successful agent-bdfl run's start")
    parser.add_argument("--repo", default=os.environ.get("GITHUB_REPOSITORY"), help="owner/name; default $GITHUB_REPOSITORY")
    args = parser.parse_args()

    repo = args.repo or json.loads(gh("repo", "view", "--json", "nameWithOwner"))["nameWithOwner"]
    if args.since:
        anchor, source = iso(args.since), "given"
    else:
        anchor, run_id = previous_run_start(repo, os.environ.get("GITHUB_RUN_ID"))
        source = f"start of run {run_id}"

    print(f"anchor {anchor} ({source})")

    runs = run_list(repo, RUN_SCAN)
    if breached(runs, RUN_SCAN, anchor):
        runs = run_list(repo, RUN_SCAN_DEEP)
    if breached(runs, RUN_SCAN_DEEP, anchor):
        print(f"\nINCOMPLETE: more than {RUN_SCAN_DEEP} runs since the anchor; the oldest are not listed.")

    agent_runs = [r for r in runs if r["name"].startswith(AGENT_PREFIX)]
    pending = [r for r in agent_runs if r["status"] != "completed"]
    window = [
        r for r in agent_runs
        if in_window(r, anchor) and (r["conclusion"] or "") not in NOT_A_SESSION
    ]
    window.sort(key=lambda r: r["updatedAt"])

    workspace = tempfile.mkdtemp(prefix="retrospect-")
    read, skipped, openers, orphans, phantoms, samples = 0, 0, 0, [], [], []
    try:
        for run in window:
            directory = download(run["databaseId"], workspace)
            if directory is None:
                why = hollow(repo, run["databaseId"])
                if why == "skipped":
                    skipped += 1
                elif why == "phantom":
                    phantoms.append(run)
                else:
                    orphans.append(run)
                continue
            meta, response = read_session(directory)
            openers += describe(run, meta, response)
            read += 1
            when = iso(run["updatedAt"])
            for info in meta.get("rate_limit_events") or []:
                if isinstance(info, dict):
                    samples.append((when, info))
    finally:
        shutil.rmtree(workspace, ignore_errors=True)

    if skipped:
        print(f"\nguard-skipped: {skipped} runs held no session (pause, throttle or exhausted ladder); nothing to read.")

    if orphans:
        print("\nno artifact (died before the audit step; the log is the only story here):")
        for run in orphans:
            print(f"    {iso(run['updatedAt'])}  {run['name']}  {run['conclusion']}  {run['url']}")

    if phantoms:
        print("\nphantom (GitHub raised the run and scheduled no job; no session, no log, nothing to read; #553):")
        for run in phantoms:
            print(f"    {iso(run['updatedAt'])}  {run['name']}  {run['conclusion']}  {run['url']}")

    if pending:
        print("\nstill running (judged in a later window, not dropped):")
        for run in pending:
            print(f"    {run['name']}  {run['displayTitle']}  {run['url']}")

    comments, bypassed = attribution_report(repo, anchor)

    budget(samples, anchor)
    print(
        f"\nretrospect: sessions {read} | openers {openers} | skipped {skipped} "
        f"| no-artifact {len(orphans)} | phantom {len(phantoms)} | pending {len(pending)} "
        f"| issue-comments {comments} | bypassed {bypassed} | since {anchor}"
    )


if __name__ == "__main__":
    main()
