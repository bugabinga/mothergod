#!/usr/bin/env python3
"""Capture before/after stills of every site/ page a pushed branch changes.

Extensionless and executable because agents type it as a command mid-session,
like tg-send and push-branch.

The operator asked to see site changes as pixels, not prose (issue #636,
Telegram, 2026-09-20). The mechanism is a property of the run rather than a
step an agent remembers (ADR-0022): this reads push-branch's own record of
what the checkout pushed (`push-branch-refs.json` under the git dir), so a
session that pushed a branch touching site/ gets its evidence captured
whether or not it thought about it, and one that never touched site/ costs
nothing but the read.

Three constraints, each of which cost a failed attempt when the mechanism
was designed (issue #658):

- `file://` renders a page that does not exist: every root-relative
  reference resolves against the filesystem root. Each tree is served over
  HTTP from its own site/ directory, the deployed root per deploy-site.yml.
- The server cannot outlive one command (`deny-ci-background`), so serve,
  capture and shut down happen inside this one process.
- "Before" is a tree, not a file: the old page needs the old CSS and assets,
  so both sides are `git worktree`s, the before at the branch's merge-base
  with the base ref.

Which pages: a changed `.html` under site/ is captured; a change to any
other file under site/ (an asset every page may reference) captures every
page. Viewports are the two `web-ui` names, 375x812 and 1440x900.

Deploy-generated data: status.html and agents.html render from JSON files
that deploy-site.yml generates and never commits (status-data.json,
agent-metrics.json, trust-data.json), so a worktree alone renders "could
not load" on both sides, a pair that says nothing (PR #732 review). Every
`fetch('/<name>.json')` the pages make is discovered from their markup and
the file is fetched from the deployed site into both trees before serving,
which is what the operator sees today at sub-second cost; regenerating it
here would cost the four minutes deploy-site pays. A file the deployed
site cannot provide is recorded on the row as `missing_data` and named in
tg-photo's caption, so a meaningless pair is never a silent one.

Output: PNGs in <out-dir> plus `manifest.json`, one row per (branch, page,
viewport) with `before` and `after` file names, either null when the page
does not exist on that side. `tg-photo` reads that manifest; nothing here
talks to Telegram.

Exit 0 with a summary line when there is nothing to capture. Non-zero when
a capture that should have happened could not (no browser, a browser
failure), because a silent gap here is the defect #636 was filed against.

The browser is `SITE_SHOTS_BROWSER` when set (the tests point it at a stub),
else the first of google-chrome-stable, chromium, chromium-browser on PATH,
all of which ubuntu-latest carries (verified 2026-09-21, #658).

Usage: site-shots <out-dir> [--base <ref>] [--branch <name>=<sha>]...
                  [--data-from <url>]

`--branch` names a branch and its head explicitly, for a caller that did not
push through push-branch; without it, every branch in the push record is
processed. `--base` defaults to origin/main. `--data-from` is where the
deploy-generated files come from, https://mothergod.dev unless a test
points it at a local directory (`file:///...`).
"""

import http.server
import json
import os
import re
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading
import urllib.request

BROWSERS = ("google-chrome-stable", "chromium", "chromium-browser")
# The two viewports .claude/skills/web-ui names; narrow first, so a media
# group reads phone-then-desktop.
VIEWPORTS = ((375, 812), (1440, 900))
# push-branch's record of what this checkout pushed, per branch.
OWN_PUSHES = "push-branch-refs.json"
SITE = "site"
# The deployed site, where deploy-generated data files are fetched from.
DATA_FROM = "https://mothergod.dev"
# Cloudflare's edge answers 403 to urllib's default User-Agent (tg-send
# learned this on the worker); our tooling says who it is.
UA = "mothergod-site-shots"
# A page's own reference to a deploy-generated file: fetch('/x.json').
DATA_REF = re.compile(r"""fetch\(\s*['"]/([\w.-]+\.json)['"]""")
# Seconds one capture may take before it counts as a failed shot. The
# environment override exists for the hang test; nothing in production sets it.
TIMEOUT = float(os.environ.get("SITE_SHOTS_TIMEOUT", "60"))


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0].startswith("--"):
        print(__doc__.split("Usage:")[1].strip(), file=sys.stderr)
        return 2
    out_dir, args = os.path.abspath(args[0]), args[1:]
    base = "origin/main"
    data_from = DATA_FROM
    branches = {}
    while args:
        if args[0] == "--base" and len(args) > 1:
            base, args = args[1], args[2:]
        elif args[0] == "--data-from" and len(args) > 1:
            data_from, args = args[1].rstrip("/"), args[2:]
        elif args[0] == "--branch" and len(args) > 1 and "=" in args[1]:
            name, sha = args[1].split("=", 1)
            branches[name] = sha
            args = args[2:]
        else:
            print(f"site-shots: unexpected argument {args[0]!r}", file=sys.stderr)
            return 2
    if not branches:
        branches = own_pushes()
    if not branches:
        print("site-shots: this checkout pushed no branch; nothing to capture")
        return 0

    # Rows accumulate here, outside any branch's failure: a shot that
    # fails costs that shot and an error line, never the rows already
    # captured for other pages or branches (PR #732 review).
    rows = []
    failures = 0
    try:
        for branch, sha in branches.items():
            try:
                failures += capture_branch(branch, sha, base, out_dir, rows, data_from)
            except CaptureError as err:
                failures += 1
                print(f"site-shots: {branch}: {err}", file=sys.stderr)
    finally:
        # Whatever escapes above, the rows already captured are on disk and
        # tg-photo reads only this file: the manifest is written on every
        # exit, so a crash costs the shots after it, not the ones before.
        os.makedirs(out_dir, exist_ok=True)
        with open(os.path.join(out_dir, "manifest.json"), "w", encoding="utf-8") as fh:
            json.dump({"shots": rows}, fh, indent=1)
    print(f"site-shots: {len(rows)} shot(s) in {out_dir}")
    return 1 if failures else 0


class CaptureError(Exception):
    """A capture that should have happened and could not."""


def capture_branch(branch: str, sha: str, base: str, out_dir: str, rows: list,
                   data_from: str) -> int:
    """Append this branch's rows to `rows`; return how many shots failed."""
    ensure_object(branch, sha)
    merge_base = git("merge-base", base, sha).strip()
    if not merge_base:
        raise CaptureError(f"no merge-base between {base} and {sha}")
    changed = git("diff", "--name-only", merge_base, sha, "--", SITE).split()
    if not changed:
        print(f"site-shots: {branch}: no change under {SITE}/")
        return 0
    pages = affected_pages(changed, merge_base, sha)
    browser = find_browser()
    if not browser:
        raise CaptureError("no browser on PATH and SITE_SHOTS_BROWSER unset")

    pr = pr_number(branch)
    os.makedirs(out_dir, exist_ok=True)
    failed = 0
    with tempfile.TemporaryDirectory(prefix="site-shots-") as tmp:
        trees = {"before": worktree(tmp, "before", merge_base),
                 "after": worktree(tmp, "after", sha)}
        try:
            refs, missing = place_data(trees.values(), data_from)
            for page in pages:
                for width, height in VIEWPORTS:
                    row = {"branch": branch, "sha": sha, "base": merge_base, "pr": pr,
                           "page": page, "viewport": f"{width}x{height}",
                           "before": None, "after": None,
                           # Only what this page itself fetches and did not
                           # get; a plain page's pair is complete (PR #732,
                           # round five).
                           "missing_data": sorted(refs.get(page, set()).intersection(missing))}
                    for phase, tree in trees.items():
                        if not os.path.exists(os.path.join(tree, page)):
                            continue
                        name = f"{slug(branch)}-{slug(page)}-{width}x{height}-{phase}.png"
                        try:
                            shoot(browser, os.path.join(tree, SITE), page, width, height,
                                  os.path.join(out_dir, name))
                        except CaptureError as err:
                            failed += 1
                            print(f"site-shots: {branch}: {phase} {err}", file=sys.stderr)
                            continue
                        row[phase] = name
                    rows.append(row)
        finally:
            for tree in trees.values():
                subprocess.run(["git", "worktree", "remove", "--force", tree],
                               capture_output=True)
    print(f"site-shots: {branch}: {len(pages)} page(s) x {len(VIEWPORTS)} viewports, "
          f"before {merge_base[:7]} after {sha[:7]}"
          + (f", {failed} shot(s) failed" if failed else ""))
    return failed


def affected_pages(changed: list, before: str, after: str) -> list:
    """Changed pages, or every page when a shared asset changed."""
    html = sorted(p for p in changed if p.endswith(".html"))
    if len(html) == len(changed):
        return html
    pages = set()
    for tree in (before, after):
        pages.update(p for p in git("ls-tree", "-r", "--name-only", tree, "--", SITE).split()
                     if p.endswith(".html"))
    return sorted(pages)


def shoot(browser: str, root: str, page: str, width: int, height: int, out: str) -> None:
    """One viewport of one page, served over HTTP from its tree's site/."""
    handler = type("Handler", (http.server.SimpleHTTPRequestHandler,), {
        "__init__": lambda self, *a, **k: http.server.SimpleHTTPRequestHandler.__init__(
            self, *a, directory=root, **k),
        "log_message": lambda *a: None,
    })
    server = socketserver.ThreadingTCPServer(("127.0.0.1", 0), handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    where = f"{page} at {width}x{height}"
    try:
        url = f"http://127.0.0.1:{server.server_address[1]}/{page[len(SITE) + 1:]}"
        proc = subprocess.run(
            [browser, "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars",
             f"--window-size={width},{height}", f"--screenshot={out}",
             "--virtual-time-budget=2000", url],
            capture_output=True, text=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        # A hang is a failed shot like any other, so the per-shot handling
        # in capture_branch applies to it (PR #732 review, round two).
        raise CaptureError(f"{where}: browser timed out after {TIMEOUT:g}s") from None
    except (subprocess.SubprocessError, OSError) as err:
        raise CaptureError(f"{where}: cannot run browser {browser}: {err}") from None
    finally:
        server.shutdown()
        server.server_close()
    if proc.returncode != 0 or not os.path.exists(out):
        raise CaptureError(f"{where}: browser exit {proc.returncode}: "
                           f"{proc.stderr.strip()[-300:]}")


def place_data(trees, data_from: str) -> tuple:
    """Fetch every deploy-generated file the pages reference into each tree.

    Returns (refs, missing): the names each page references, keyed by its
    site-relative path, and the names the source could not provide. Each
    missing name is one stderr line here and a caption note downstream on
    the pages that reference it, never a stop: the static parts of the page
    are still evidence.
    """
    refs = {}
    for tree in trees:
        site = os.path.join(tree, SITE)
        for root, _, files in os.walk(site):
            for entry in files:
                if not entry.endswith(".html"):
                    continue
                path = os.path.join(root, entry)
                with open(path, encoding="utf-8", errors="replace") as fh:
                    page = os.path.relpath(path, tree)
                    refs.setdefault(page, set()).update(DATA_REF.findall(fh.read()))
    names = set().union(*refs.values()) if refs else set()
    missing = set()
    for name in sorted(names):
        try:
            request = urllib.request.Request(f"{data_from}/{name}", headers={"User-Agent": UA})
            with urllib.request.urlopen(request, timeout=20) as response:
                data = response.read()
        except (OSError, ValueError) as err:
            missing.add(name)
            print(f"site-shots: {name}: not available from {data_from}: {err}", file=sys.stderr)
            continue
        for tree in trees:
            with open(os.path.join(tree, SITE, name), "wb") as fh:
                fh.write(data)
    return refs, missing


def worktree(tmp: str, name: str, ref: str) -> str:
    path = os.path.join(tmp, name)
    git("worktree", "add", "--detach", path, ref)
    return path


def ensure_object(branch: str, sha: str) -> None:
    """push-branch commits through the API, so the pushed head is not local."""
    if subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                      capture_output=True).returncode == 0:
        return
    proc = subprocess.run(["git", "fetch", "--quiet", "origin", branch],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise CaptureError(f"cannot fetch {branch}: {proc.stderr.strip()[-200:]}")


def own_pushes() -> dict:
    path = git("rev-parse", "--git-path", OWN_PUSHES).strip()
    try:
        with open(path, encoding="utf-8") as fh:
            record = json.load(fh)
    except (OSError, ValueError):
        return {}
    return record if isinstance(record, dict) else {}


def pr_number(branch: str):
    """The PR on this branch, for the caption; best effort, never fatal."""
    if not shutil.which("gh"):
        return None
    proc = subprocess.run(
        ["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "number",
         "--jq", ".[0].number // empty"],
        capture_output=True, text=True)
    return int(proc.stdout) if proc.returncode == 0 and proc.stdout.strip().isdigit() else None


def find_browser():
    named = os.environ.get("SITE_SHOTS_BROWSER")
    if named:
        return named
    return next((b for b in BROWSERS if shutil.which(b)), None)


def slug(text: str) -> str:
    return "".join(c if c.isalnum() else "-" for c in text).strip("-")


def git(*args: str) -> str:
    proc = subprocess.run(["git", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        raise CaptureError(f"git {' '.join(args)}: {proc.stderr.strip()[-200:]}")
    return proc.stdout


if __name__ == "__main__":
    sys.exit(main())
