#!/usr/bin/env bash
set -euo pipefail

executable=${1:?test executable is required}
shift
remote_dir="/data/local/tmp/mothergod-test-${RANDOM}-$$"
remote="$remote_dir/test"
corpus="$remote_dir/adversarial"

cleanup() {
  adb shell rm -rf "$remote_dir" >/dev/null 2>&1 || true
}
trap cleanup EXIT

adb shell mkdir -p "$corpus"
adb push "$executable" "$remote" >/dev/null
adb push "$GITHUB_WORKSPACE/tests/adversarial/." "$corpus/" >/dev/null
adb shell chmod 755 "$remote"
adb shell env MOTHERGOD_ADVERSARIAL_DIR="$corpus" "$remote" "$@"
