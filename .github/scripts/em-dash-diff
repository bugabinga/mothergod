#!/usr/bin/env python3
"""Fail on a line a diff adds to a prose file carrying an em dash (U+2014).

Extensionless and executable, like adr-data: ci.yml's `em-dash` job pipes
`git diff --unified=0 HEAD^1 HEAD` into it on every PR and push.

Reads a unified diff on stdin and prints every added line in a prose file
(prose.py's suffixes) that carries the character, literal or as the escape
`\\u2014`, as `path:line: text`, then the rule, and exits 1. Nothing found
exits 0 and prints nothing.

CLAUDE.md's Voice rule is "No em dash, ever". `deny-em-dash` compiled it
where text leaves a session as a Bash argument, and prose written through
Edit or Write leaked past it as a file: research/JOURNAL.md carried 524
em-dash lines when #774 was filed and 571 three weeks later, each added by
a session and passed by two review rounds. Since #774 the hook reads Edit
and Write too; this is the gate for what reaches main without the hook, a
human's push first among them. Diff-scoped, not whole-file, because about
800 lines of the tree carry the character and a whole-file rule starts
with a rewrite nobody asked for; this holds the line from the day it lands
and the backlog shrinks as lines get touched. A moved line is an added
line and gets fixed in passing, by design.

Hunk arithmetic: a `diff --git` line opens a file and a `+++ b/<path>` in
its header names it (`+++ /dev/null` is a deletion, nothing to read);
`@@ -a[,b] +c[,d] @@` sets the next new-side line number to c; every `+`
line is reported at that number and advances it, a context line advances
it, a `-` line does not. Inside a hunk every line starts with `+`, `-`, a
space or `\\`, so a header is never mistaken for content or content for a
header. A path git C-quotes (a non-ASCII name) is not unescaped and so
never matches a suffix; none exists in this tree.

`findings` is pure; em-dash-diff.test.mjs pins the arithmetic and both
directions by spawning this script on fixture diffs.
"""

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import prose  # noqa: E402, the scripts directory is the import root

HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")

MESSAGE = (
    "CLAUDE.md Voice: no em dash, ever; comma, colon, semicolon or period. "
    "Rewrite each line above with the punctuation you meant, then push."
)


def findings(diff: str) -> list[tuple[str, int, str]]:
    """(path, line, text) for every added line in a prose file carrying an em dash."""
    found = []
    path = None
    in_header = False
    line = 0
    for raw in diff.splitlines():
        if raw.startswith("diff --git "):
            path = None
            in_header = True
        elif in_header and raw.startswith("+++ "):
            target = raw[4:]
            path = target[2:] if target.startswith("b/") else None
        elif raw.startswith("@@"):
            in_header = False
            match = HUNK.match(raw)
            line = int(match.group(1)) if match else 0
        elif in_header:
            continue
        elif raw.startswith("+"):
            text = raw[1:]
            if path is not None and prose.is_prose(path) and prose.carries(text):
                found.append((path, line, text))
            line += 1
        elif raw.startswith(" "):
            line += 1
    return found


def main() -> int:
    """Print the findings and the rule; 1 when there is one, 0 otherwise."""
    diff = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    found = findings(diff)
    for path, line, text in found:
        print(f"{path}:{line}: {text}")
    if not found:
        return 0
    print(f"added lines carrying an em dash (U+2014): {len(found)}. {MESSAGE}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
