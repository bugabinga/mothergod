#!/usr/bin/env python3
"""Deny full-gate recomputes inside pull_request CI sessions (PreToolUse hook).

A pull_request-triggered session sits on a commit that already carries
the required checks: fmt, clippy, test, doc, ratio (ci.yml). That is
the reviewer on every PR, and also the BDFL's opened/reopened wakes
(agent-bdfl.yml); binding both is decided, not incidental, because the
no-signal argument keys on the commit's checks, not on the seat
(PR #333 review thread). Re-running the same unscoped command locally recomputes
an identical result at cold-build runner cost and adds no signal. Prompt
prose has said so since #237 (af0bdc5); run 33229032665 re-ran `cargo x
test` anyway, detached it with a shell `&`, deleted the worktree under
it, and posted a pass claim for a run that died compiling. Second loss
for the prose, and this one cost trust, so the rule compiles into this
guard (ADR-0022). The shell-`&` variant is deliberately not parsed here:
backgrounding only paid because the recompute was long, so denying the
recompute removes the reason to detach.

Denied, per shell segment (split on `;`, `&`, `|`): `cargo x check` in
any form, `cargo x test|lint|doc|fmt` without a ` -- <arg>` scope, and
`cargo test` without `-p`/`--package` or a ` -- <arg>` filter. The
escape demands a real argument after the `--`, because a bare trailing
`--` passes no filter and runs the whole suite. Quote contents are
blanked before matching, so mentioning a command (`grep 'cargo x
check'`) is not running it; a non-empty quoted span leaves a
placeholder argument, so a quoted scope (`cargo x test -- 'src/lz'`)
still scopes, while empty quotes vanish, so `cargo test -- ''` stays
bare and denied (#333 review, round two). The symmetric cost, that
`bash -c 'cargo x test'` slips through, is accepted for a guardrail
aimed at a forgetful model, not an adversary. Scoped runs are the reviewer's real job and stay
allowed: `cargo test -p <crate>`, `cargo x test -- <path>`,
feature-flagged builds CI does not cover, and any segment carrying
`--help`. Matching keys on our own task names and GitHub's
GITHUB_EVENT_NAME, so only our own renames break it, and a false deny
teaches its own correction in stderr.

Contract: reads the PreToolUse JSON on stdin. Outside GitHub Actions,
outside a pull_request event, or for any tool but Bash, everything is
allowed, as are malformed JSON and a null tool_input (the #324 shape).
Exit 2 denies; stderr is shown to the model.

Liveness: every deny appends a fixed-vocabulary line to
GITHUB_STEP_SUMMARY, so the run page shows the guard working; the
audit artifact excludes transcripts by design and would never show a
deny. A missing or broken hook script errors loudly in-session on
every Bash call.
"""

import json
import os
import re
import sys

# One entry per denied class: (name for the summary line, trigger, scope
# escape). A segment matching the trigger is denied unless it also
# matches the escape; escape None means no scoped form exists.
DENIED = (
    ("cargo x check", re.compile(r"\bcargo\s+x\s+check\b"), None),
    (
        "unscoped cargo x test/lint/doc/fmt",
        re.compile(r"\bcargo\s+x\s+(?:test|lint|doc|fmt)\b"),
        re.compile(r"\s--\s+\S"),
    ),
    (
        "unscoped cargo test",
        re.compile(r"\bcargo\s+test\b"),
        re.compile(r"(?:^|\s)(?:-p\b|--package\b)|\s--\s+\S"),
    ),
)

QUOTED = re.compile(r"'[^']*'|\"[^\"]*\"")


def blank_quotes(command: str) -> str:
    """Replace each quoted span: non-empty becomes a placeholder argument
    (a quoted scope must still satisfy the escape), empty disappears (an
    empty filter scopes nothing, so `-- ''` must read as bare)."""
    return QUOTED.sub(lambda m: "q" if len(m.group(0)) > 2 else "", command)

MESSAGE = (
    "fmt, clippy, test, doc and ratio already ran on this exact commit "
    "as required checks; an unscoped re-run recomputes an identical "
    "result at cold-build cost and adds no signal (#237). Read them "
    "with `gh pr checks <n>`. A pending check is not a gap you fill by "
    "re-running: say so, and merge-pr's exit 2 arms auto-merge. Spend "
    "Bash on what CI does not check, scoped to the PR's claims: `cargo "
    "test -p <crate>`, `cargo x test -- <path>`, feature-flagged "
    "builds, through .github/scripts/probe."
)


def denied_class(command: str) -> str | None:
    """Name the denied class the command falls in, or None if allowed."""
    for segment in re.split(r"[;&|]+", blank_quotes(command)):
        if "--help" in segment:
            continue
        for name, trigger, escape in DENIED:
            if trigger.search(segment) and not (
                escape and escape.search(segment)
            ):
                return name
    return None


def main() -> int:
    """Allow (0) or deny (2) the tool call described on stdin."""
    if os.environ.get("GITHUB_ACTIONS") != "true":
        return 0
    if os.environ.get("GITHUB_EVENT_NAME") != "pull_request":
        return 0
    try:
        call = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    if call.get("tool_name") != "Bash":
        return 0
    tool_input = call.get("tool_input")
    if not isinstance(tool_input, dict):
        return 0
    command = tool_input.get("command")
    if not isinstance(command, str):
        return 0
    name = denied_class(command)
    if name is None:
        return 0
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as fh:
            fh.write(f"deny-review-recompute: denied {name}\n")
    print(MESSAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
