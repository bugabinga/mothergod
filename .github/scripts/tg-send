#!/usr/bin/env python3
"""Send one Telegram message to the operator, with repo refs already linked.

Extensionless and executable because agents type it as a command mid-session,
like settle-push.

It owns six things every agent otherwise redoes by hand, three of which fail
silently when done wrong:

- `#142` becomes a link (operator request, 2026-08-23). GitHub's `/issues/<n>`
  URL redirects to the PR when the number is a PR, so one form covers both and
  the sender never has to know which it is.
- HTML escaping, which `parse_mode=HTML` makes mandatory. Unescaped `<` makes
  Telegram reject the message or eat the rest of it, and the agent that wrote
  it has already moved on.
- The token stays out of argv (hard rule 10). It is read from the environment,
  spent inside this process, and scrubbed from any error text before it is
  printed, because urllib puts the request URL in its exceptions.
- Silence is never success: a Telegram error is a non-zero exit with the
  API's own description, not a swallowed 400.
- The bot's "typing..." indicator counts down here, because this is the moment
  the operator gets an answer. The worker starts it when their message lands
  and keeps it up while answers are still owed (infra/telegram-worker/); a
  delivered message is the only honest way to decrement that.
- The delivery is recorded in the KV chat log, because this process is the
  only party that knows the send succeeded (#183).

Reads the body from stdin. On success the only stdout is `message_id=<n>`,
self-describing because a bare `429` was once read as Telegram's rate-limit
status and retried into four identical status lines (#535); on failure the
exit is non-zero, stdout stays empty and stderr carries the reason.

`--notice` marks the message as a notification rather than a turn in the
operator conversation: it answers nothing, so it must not decrement the
typing counter, and it comes from a deterministic workflow step, so it needs
no chat-log receipt; logging it would evict real conversation from the
40-entry memory at machine cadence. The mechanical heartbeat run notice
(agent-heartbeat.yml) is the caller this exists for.

Usage: tg-send [--reply-to <message_id>] [--notice] < body
"""

import html
import json
import os
import re
import sys
import urllib.error
import urllib.request
from itertools import groupby

# `scrub` redacts every credential shape from the outgoing body;
# `scrub_token` below removes one known token from API error text.
from secret_scrub import REDACTION, scrub
import kv
import stdin_body

# The host is overridable so tg-send.test.mjs can stand in for Telegram and
# pin what each exit prints; nothing in production sets it.
API = os.environ.get("TELEGRAM_API_BASE", "https://api.telegram.org") + "/bot{}/sendMessage"
# Cloudflare's edge answers 403 to urllib's default User-Agent, so every
# stop_typing() call was refused before reaching our own worker and the
# indicator ran on until the worker capped it. Our tooling says who it is.
UA = "mothergod-tg-send"
LIMIT = 4096  # Telegram's hard cap on message text
# The webhook worker, whose custom domain is set in
# infra/telegram-worker/wrangler.toml.
STOP_TYPING = "https://bot.mothergod.dev/typing/stop"
# The chat log: one KV key holding the last KEEP turns of operator
# conversation, the only memory that outlives a run. Same key the webhook
# worker appends the operator's side to (infra/telegram-worker/worker.js).
KV = ("https://api.cloudflare.com/client/v4/accounts/{}"
      "/storage/kv/namespaces/{}/values/{}")
CHATLOG = "chatlog"
KEEP = 40  # entries retained; this number is the whole retention policy
SUMMARY = 200  # chars of an entry's text; 40 entries must stay one screenful
# The em dash CLAUDE.md forbids. Where a writer is still present the rule is
# compiled as a deny (deny-em-dash); this is the destination with no writer
# left, because run-notice pipes a finished final response through here. A
# mid-sentence dash becomes the comma the rule names first; one opening a
# line just goes.
EM_DASH = re.compile("(?m)^\u2014[ \t]*|[ \t]*\u2014[ \t]*")

# The house markdown dialect, as one left-to-right pass. Alternation order is
# precedence: code wins, so a `**x**` inside backticks stays literal, and a
# link wins over the ref inside its own URL. One pass with no re-entry is what
# keeps the output well-formed without a parser, because nothing emitted here
# can be rematched by this pattern.
#
# A ref is `#<digits>`, not preceded by a word character, `/` or `#`, so
# `abc#1`, a URL fragment and `##1` are left alone. Italic demands a non-word
# character on both outsides, because `seven_day: 56% used` is a budget
# footer, not emphasis, and the naive form runs from that underscore to
# whichever one comes next, three lines later.
#
# The scrubber's marker goes first and comes out as typed. It is three
# asterisks a side and bold is two, so the bold rule read `***REDACTED***`
# as `*<b>REDACTED</b>*` (#598). The marker is one constant across every
# exit so a reader recognises it anywhere; teaching this renderer the
# constant is what keeps it one.
INLINE = re.compile(
    rf"(?P<marker>{re.escape(REDACTION)})"
    r"|`(?P<code>[^`\n]+)`"
    r"|\[(?P<label>[^\]\n]+)\]\((?P<href>[^)\s\"]+)\)"
    r"|\*\*(?P<bold>[^*\n]+)\*\*"
    r"|(?<!\w)_(?P<italic>[^_\n]+)_(?!\w)"
    r"|(?<![\w/#])#(?P<ref>\d{1,6})\b"
)
# Line-level forms. Telegram has no heading and no list, so a heading becomes
# a bold line and a bullet becomes the character a human would have typed.
# Both require the space after the marker, which is what keeps `#542` a ref
# and `---` a rule rather than an empty bullet.
HEADING = re.compile(r"^ {0,3}#{1,6} +(.*?) *#* *$")
BULLET = re.compile(r"^( *)[-*] +")
DOT = "•"  # Telegram has no list markup; this is what a human would type
# A table has no Telegram form either: GitHub draws the grid, a phone shows
# the pipes (operator, 2026-10-29). Each body row becomes one line led by
# its first cell, the other cells each named by their header, which is what
# a human types to say a table in a chat. A row is a line opening with a
# pipe; a block is a table only when its second row is a delimiter row of
# the header's width, GFM's own test, so a lone piped line stays the text
# it is.
ROW = re.compile(r"^ {0,3}\|")
DELIMITER = re.compile(r"^:?-+:?$")
# A cell boundary is a bare pipe. An escaped one is GFM's way to put a pipe
# in a cell, and one inside a code span is literal, as INLINE promises; each
# is consumed whole here so only group 1 marks a boundary.
PIPE = re.compile(r"\\.|`[^`]*`|(\|)")
# A fenced block is quoted text: what the operator copies from the phone
# must be what was sent, and a shell comment arriving bold or a fenced table
# arriving as bullets is not (#1794). Telegram's form for it is `<pre>`, so
# a fence's lines pass through as one, with no line or inline form applied.
# GFM's rules, which GitHub renders the same text by: the opening fence is
# three or more backticks after at most three spaces with no backtick in
# its info string, the closing fence is at least as long and alone on its
# line, and an unclosed fence runs to the end of the body.
FENCE = re.compile(r"^ {0,3}(`{3,})(?!.*`)")
CLOSE = re.compile(r"^ {0,3}(`{3,})[ \t]*$")


def main() -> int:
    args = sys.argv[1:]
    reply_to = None
    notice = False
    while args and args[0] in ("--reply-to", "--notice"):
        if args[0] == "--notice":
            notice, args = True, args[1:]
            continue
        if len(args) < 2:
            print("tg-send: --reply-to needs a message id", file=sys.stderr)
            return 2
        reply_to, args = int(args[1]), args[2:]
    if args:
        print(f"tg-send: unexpected argument {args[0]!r}; body comes from stdin",
              file=sys.stderr)
        return 2

    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("OPERATOR_TELEGRAM_CHAT_ID")
    if not token or not chat:
        print("tg-send: TELEGRAM_BOT_TOKEN and OPERATOR_TELEGRAM_CHAT_ID must be set",
              file=sys.stderr)
        return 2

    body = stdin_body.read()
    if not body:
        print("tg-send: empty body; refusing to send", file=sys.stderr)
        return 2

    # Same exit, same rule as gh-comment: redact, never block, warn loudly.
    # The chat log this message lands in is a Cloudflare KV the operator reads
    # on a phone, so a leaked token would outlive the run that printed it.
    body, redactions = scrub(body)
    if redactions:
        print(f"tg-send: redacted {redactions} credential-shaped string(s) "
              "from the body; a secret reached your text (CLAUDE.md rule 10)",
              file=sys.stderr)

    body = EM_DASH.sub(swap_dash, body)
    repo = os.environ.get("GITHUB_REPOSITORY", "bugabinga/mothergod")
    text = render(body, repo)
    # Length is checked after rendering, because the markup is what actually
    # travels and it is several times the source in a link-dense message.
    if len(text) > LIMIT:
        print(f"tg-send: {len(text)} chars after linking, over Telegram's {LIMIT}; "
              "split it rather than let the API truncate", file=sys.stderr)
        return 2

    payload = {
        "chat_id": chat,
        "text": text,
        "parse_mode": "HTML",
        # Refs are navigation, not content. A preview card per link would bury
        # the message that carries them.
        "link_preview_options": {"is_disabled": True},
    }
    if reply_to is not None:
        payload["reply_parameters"] = {"message_id": reply_to}

    request = urllib.request.Request(
        API.format(token),
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "User-Agent": UA},
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            sent = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace")
        try:
            detail = json.loads(detail).get("description", detail)
        except json.JSONDecodeError:
            pass
        print(f"tg-send: HTTP {error.code}: {scrub_token(detail, token)}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"tg-send: {scrub_token(str(error), token)}", file=sys.stderr)
        return 1

    if not notice:
        stop_typing()
        record(sent["result"], reply_to, body)
    print(f"message_id={sent['result']['message_id']}")
    return 0


def swap_dash(match: re.Match) -> str:
    """A comma for a dash mid-sentence, nothing for one that opens a line."""
    at_line_start = match.start() == 0 or match.string[match.start() - 1] == "\n"
    return "" if at_line_start else ", "


def render(body: str, repo: str) -> str:
    """The house markdown dialect, in the only markup Telegram accepts.

    CLAUDE.md mandates one markdown dialect for every posted text, so agents
    write `**bold**` everywhere and have no reason to know that this one
    destination speaks HTML. Telegram printed the asterisks literally, and
    every summary arrived wearing its own markup (operator report,
    2026-09-13). Translating here is what keeps the dialect single: callers
    write the house dialect, and the process that owns the destination owns
    the translation.

    Escaping runs first, so any markup character already in the body is text
    by the time the patterns see it and cannot be read as a tag. Only the
    forms Telegram has a tag for survive; everything else stays literal,
    which is the honest outcome for a subset this small and the reason the
    subset can stay small. A fenced block is the one run of lines no form
    touches: it arrives as one `<pre>` block, as typed.
    """
    parts = []
    escaped = html.escape(body, quote=False).split("\n")
    for fenced, block in segments(escaped):
        if fenced:
            text = "\n".join(block)
            if text:
                parts.append(f"<pre>{text}</pre>")
        else:
            parts.append(INLINE.sub(lambda m: inline(m, repo), "\n".join(prose(block))))
    return "\n".join(parts)


def segments(lines: list[str]):
    """Runs of lines, fenced or not, in order; the fence lines are consumed.

    Yields `(fenced, lines)`. A prose run is never empty; a fenced run can
    be. A backtick run shorter than the opening fence is content inside it,
    which is how a fence shows a fence.
    """
    prose_lines, code, width = [], None, None
    for line in lines:
        if width is None:
            opening = FENCE.match(line)
            if opening:
                if prose_lines:
                    yield False, prose_lines
                prose_lines, code, width = [], [], len(opening[1])
            else:
                prose_lines.append(line)
        else:
            closing = CLOSE.match(line)
            if closing and len(closing[1]) >= width:
                yield True, code
                code, width = None, None
            else:
                code.append(line)
    if width is not None:
        yield True, code
    elif prose_lines:
        yield False, prose_lines


def prose(lines: list[str]) -> list[str]:
    """Lines outside a fence: a table as chat lines, every other line by form."""
    out = []
    for is_row, block in groupby(lines, key=lambda line: ROW.match(line) is not None):
        block = list(block)
        out.extend(table(block) if is_row else map(line_form, block))
    return out


def line_form(line: str) -> str:
    """One line outside a table: a heading goes bold, a bullet gets its dot."""
    heading = HEADING.match(line)
    if heading:
        return f"<b>{heading[1]}</b>" if heading[1] else ""
    return BULLET.sub(rf"\1{DOT} ", line)


def table(rows: list[str]) -> list[str]:
    """Consecutive piped lines as chat lines; without a delimiter row, as typed.

    Nothing the sender wrote is dropped except what GitHub drops too: a
    body row's cells past the header's width, which GFM ignores. A header
    with no body rows is still content, so it stays as one line.
    """
    grid = [cells(row) for row in rows]
    if (len(grid) < 2 or len(grid[1]) != len(grid[0])
            or not all(DELIMITER.match(cell) for cell in grid[1])):
        return rows
    header, body = grid[0], grid[2:]
    if not body:
        return [", ".join(name for name in header if name)]
    lines = []
    for row in body:
        pairs = ", ".join(f"{name} {cell}".strip()
                          for name, cell in zip(header[1:], row[1:]) if cell)
        text = ": ".join(part for part in (row[0], pairs) if part)
        if text:
            lines.append(f"{DOT} {text}")
    return lines


def cells(row: str) -> list[str]:
    """One piped line's cells, stripped, an escaped pipe back to a pipe.

    The leading pipe opens the row and a trailing one closes it; neither
    bounds a cell, so the piece before the first and a blank piece after the
    last are not cells. The result is never empty.
    """
    bounds = [match.start() for match in PIPE.finditer(row) if match[1]]
    pieces = [row[start + 1:end] for start, end in zip(bounds, [*bounds[1:], len(row)])]
    if len(pieces) > 1 and not pieces[-1].strip():
        pieces.pop()
    return [piece.strip().replace("\\|", "|") for piece in pieces]


def inline(match: re.Match, repo: str) -> str:
    """One inline form, rendered. Exactly one group of INLINE is ever set."""
    if match["marker"] is not None:
        return match["marker"]
    if match["code"] is not None:
        return f"<code>{match['code']}</code>"
    if match["href"] is not None:
        return f'<a href="{match["href"]}">{match["label"]}</a>'
    if match["bold"] is not None:
        return f"<b>{match['bold']}</b>"
    if match["italic"] is not None:
        return f"<i>{match['italic']}</i>"
    ref = match["ref"]
    # GitHub's /issues/<n> redirects to the PR when the number is a PR, so one
    # form covers both and the sender never has to know which it is.
    return f'<a href="https://github.com/{repo}/issues/{ref}">#{ref}</a>'


def record(sent: dict, reply_to: int | None, body: str) -> None:
    """Append this delivery to the KV chat log, so the next context knows.

    Runs are amnesiac and the chat log is the continuity. Every other channel
    this project writes to leaves its receipt in the repository; Telegram was
    the only write-only one, so a run that crossed a context boundary could not
    tell whether it had already sent the operator's status line, and both
    available answers were wrong: send again and one wake reads as two runs,
    stay quiet and a 40-minute run ends silent (#183, observed in run
    32656616847, which stayed quiet).

    The receipt belongs here rather than in a prompt instruction because this
    process is the only party that knows the send succeeded, and bookkeeping an
    agent has to remember is bookkeeping it will eventually forget (ADR-0022).
    `run_id` is what turns "have I already spoken?" from a coin flip into a
    lookup.

    Never fatal. The message is already delivered, so a non-zero exit here
    would report a failure that did not happen and the caller would resend it.
    A lost receipt costs the next context its certainty, which is exactly the
    state this function replaces, and it says so on stderr rather than
    pretending.
    """
    token = os.environ.get("CLOUDFLARE_API_TOKEN")
    if not token:
        print("tg-send: sent, but no CLOUDFLARE_API_TOKEN in the environment,"
              " so nothing recorded it; a later context cannot tell that this "
              "run already spoke", file=sys.stderr)
        return

    url = KV.format(kv.ACCOUNT, kv.NAMESPACE, CHATLOG)
    # Building the entry sits inside the guard with the network calls, and
    # KeyError with them, because "never fatal" has to hold for every way this
    # can fail and not just the ones that seem likely. Telegram always returns
    # message_id and date on success; a day it does not is still not a day this
    # process fails a delivered message (PR #184 review).
    try:
        entry = {
            "from": "bdfl",
            "message_id": sent["message_id"],
            "date": sent["date"],
            "text": summarize(body),
            "run_id": os.environ.get("GITHUB_RUN_ID"),
        }
        if reply_to is not None:
            entry["reply_to"] = reply_to
        log = kv_read(url, token)
        log.append(entry)
        kv_write(url, token, log[-KEEP:])
    except (OSError, ValueError, KeyError) as error:
        print(f"tg-send: sent, but the chat log was not updated: "
              f"{scrub_token(str(error), token)}", file=sys.stderr)


def summarize(body: str) -> str:
    """One scannable line of what was said, not a copy of it.

    The log is memory, not an archive: 40 entries have to be readable in one
    screenful, and the message itself is already in the operator's client.
    """
    line = " ".join(body.split())
    return line if len(line) <= SUMMARY else line[: SUMMARY - 1] + "…"


def kv_read(url: str, token: str) -> list:
    """The chat log as it stands, or an empty one.

    A missing key is an empty log, not a failure: that is the state before the
    first message ever sent. Anything else that is not a JSON array is
    corruption, and overwriting it costs less than a sender that refuses to
    record because someone once wrote a string there.
    """
    request = urllib.request.Request(url, headers=kv_headers(token))
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            log = json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return []
        raise
    except json.JSONDecodeError:
        return []
    return log if isinstance(log, list) else []


def kv_write(url: str, token: str, log: list) -> None:
    """Replace the chat log.

    Cloudflare's write endpoint takes multipart/form-data with a `value` part.
    A raw body gets a 400 whose message does not mention multipart, so the
    shape is spelled out here once instead of being rediscovered.
    """
    boundary = "----mothergod-chatlog"
    body = (f"--{boundary}\r\n"
            'Content-Disposition: form-data; name="value"\r\n\r\n'
            f"{json.dumps(log)}\r\n"
            f"--{boundary}--\r\n").encode()
    request = urllib.request.Request(
        url,
        data=body,
        method="PUT",
        headers={**kv_headers(token),
                 "Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    urllib.request.urlopen(request, timeout=20).close()


def kv_headers(token: str) -> dict:
    """Cloudflare's edge answers 403 to urllib's default User-Agent."""
    return {"Authorization": f"Bearer {token}", "User-Agent": UA}


def stop_typing() -> None:
    """Report one answer delivered, so the bot stops typing when none are owed.

    Not an unconditional stop: a run draining three queued messages sends three
    replies and must keep typing between them, so the worker counts and this
    decrements.

    Best effort on purpose. The indicator is decoration and the worker caps it
    on its own, so a failure here costs a stale indicator that expires, never a
    message. A missing secret means the caller is a job that was not given the
    worker's key; that is a valid configuration, not an error.
    """
    secret = os.environ.get("TELEGRAM_WEBHOOK_SECRET")
    if not secret:
        return
    request = urllib.request.Request(
        STOP_TYPING,
        data=b"",
        headers={"x-mothergod-secret": secret, "User-Agent": UA},
        method="POST",
    )
    try:
        urllib.request.urlopen(request, timeout=5).close()
    except OSError as error:  # HTTPError included; it subclasses OSError.
        print(f"tg-send: could not stop the typing indicator: "
              f"{scrub_token(str(error), secret)}", file=sys.stderr)


def scrub_token(message: str, token: str) -> str:
    """Never print a secret (hard rule 10), whoever built the string."""
    return message.replace(token, "<redacted>")


if __name__ == "__main__":
    sys.exit(main())
