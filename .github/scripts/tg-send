#!/usr/bin/env python3
"""Send one Telegram message to the operator, with repo refs already linked.

Extensionless and executable because agents type it as a command mid-session,
like settle-push.

It owns six things every agent otherwise redoes by hand, three of which fail
silently when done wrong:

- `#142` becomes a link (operator request, 2026-08-23). GitHub's `/issues/<n>`
  URL redirects to the PR when the number is a PR, so one form covers both and
  the sender never has to know which it is.
- HTML escaping, which `parse_mode=HTML` makes mandatory. Unescaped `<` makes
  Telegram reject the message or eat the rest of it, and the agent that wrote
  it has already moved on.
- The token stays out of argv (hard rule 10). It is read from the environment,
  spent inside this process, and scrubbed from any error text before it is
  printed, because urllib puts the request URL in its exceptions.
- Silence is never success: a Telegram error is a non-zero exit with the
  API's own description, not a swallowed 400.
- The bot's "typing..." indicator counts down here, because this is the moment
  the operator gets an answer. The worker starts it when their message lands
  and keeps it up while answers are still owed (infra/telegram-worker/); a
  delivered message is the only honest way to decrement that.
- The delivery is recorded in the KV chat log, because this process is the
  only party that knows the send succeeded (#183).

Reads the body from stdin, prints the sent message_id to stdout so the caller
can log it or reply to it.

`--notice` marks the message as a notification rather than a turn in the
operator conversation: it answers nothing, so it must not decrement the
typing counter, and it comes from a deterministic workflow step, so it needs
no chat-log receipt; logging it would evict real conversation from the
40-entry memory at machine cadence. The mechanical heartbeat run notice
(agent-heartbeat.yml) is the caller this exists for.

Usage: tg-send [--reply-to <message_id>] [--notice] < body
"""

import html
import json
import os
import re
import sys
import urllib.error
import urllib.request

API = "https://api.telegram.org/bot{}/sendMessage"
# Cloudflare's edge answers 403 to urllib's default User-Agent, so every
# stop_typing() call was refused before reaching our own worker and the
# indicator ran on until the worker capped it. Our tooling says who it is.
UA = "mothergod-tg-send"
LIMIT = 4096  # Telegram's hard cap on message text
# The webhook worker, whose custom domain is set in
# infra/telegram-worker/wrangler.toml.
STOP_TYPING = "https://bot.mothergod.dev/typing/stop"
# The chat log: one KV key holding the last KEEP turns of operator
# conversation, the only memory that outlives a run. Same key the webhook
# worker appends the operator's side to (infra/telegram-worker/worker.js).
KV = ("https://api.cloudflare.com/client/v4/accounts/{}"
      "/storage/kv/namespaces/{}/values/{}")
CHATLOG = "chatlog"
KEEP = 40  # entries retained; this number is the whole retention policy
SUMMARY = 200  # chars of an entry's text; 40 entries must stay one screenful

# A ref is `#<digits>`. Not preceded by a word character, `/` or `#`, so
# `abc#1`, a URL fragment and `##1` are left alone.
REF = re.compile(r"(?<![\w/#])#(\d{1,6})\b")


def main() -> int:
    args = sys.argv[1:]
    reply_to = None
    notice = False
    while args and args[0] in ("--reply-to", "--notice"):
        if args[0] == "--notice":
            notice, args = True, args[1:]
            continue
        if len(args) < 2:
            print("tg-send: --reply-to needs a message id", file=sys.stderr)
            return 2
        reply_to, args = int(args[1]), args[2:]
    if args:
        print(f"tg-send: unexpected argument {args[0]!r}; body comes from stdin",
              file=sys.stderr)
        return 2

    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("OPERATOR_TELEGRAM_CHAT_ID")
    if not token or not chat:
        print("tg-send: TELEGRAM_BOT_TOKEN and OPERATOR_TELEGRAM_CHAT_ID must be set",
              file=sys.stderr)
        return 2

    body = sys.stdin.read().strip()
    if not body:
        print("tg-send: empty body; refusing to send", file=sys.stderr)
        return 2

    repo = os.environ.get("GITHUB_REPOSITORY", "bugabinga/mothergod")
    text = REF.sub(
        lambda m: f'<a href="https://github.com/{repo}/issues/{m[1]}">#{m[1]}</a>',
        html.escape(body, quote=False),
    )
    # Escaping only touches & < >, so the refs survive it unchanged and the
    # order above is safe. Length is checked after linking, because the anchor
    # markup is what actually travels.
    if len(text) > LIMIT:
        print(f"tg-send: {len(text)} chars after linking, over Telegram's {LIMIT}; "
              "split it rather than let the API truncate", file=sys.stderr)
        return 2

    payload = {
        "chat_id": chat,
        "text": text,
        "parse_mode": "HTML",
        # Refs are navigation, not content. A preview card per link would bury
        # the message that carries them.
        "link_preview_options": {"is_disabled": True},
    }
    if reply_to is not None:
        payload["reply_parameters"] = {"message_id": reply_to}

    request = urllib.request.Request(
        API.format(token),
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "User-Agent": UA},
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            sent = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace")
        try:
            detail = json.loads(detail).get("description", detail)
        except json.JSONDecodeError:
            pass
        print(f"tg-send: HTTP {error.code}: {scrub(detail, token)}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"tg-send: {scrub(str(error), token)}", file=sys.stderr)
        return 1

    if not notice:
        stop_typing()
        record(sent["result"], reply_to, body)
    print(sent["result"]["message_id"])
    return 0


def record(sent: dict, reply_to: int | None, body: str) -> None:
    """Append this delivery to the KV chat log, so the next context knows.

    Runs are amnesiac and the chat log is the continuity. Every other channel
    this project writes to leaves its receipt in the repository; Telegram was
    the only write-only one, so a run that crossed a context boundary could not
    tell whether it had already sent the operator's status line, and both
    available answers were wrong: send again and one wake reads as two runs,
    stay quiet and a 40-minute run ends silent (#183, observed in run
    32656616847, which stayed quiet).

    The receipt belongs here rather than in a prompt instruction because this
    process is the only party that knows the send succeeded, and bookkeeping an
    agent has to remember is bookkeeping it will eventually forget (ADR-0022).
    `run_id` is what turns "have I already spoken?" from a coin flip into a
    lookup.

    Never fatal. The message is already delivered, so a non-zero exit here
    would report a failure that did not happen and the caller would resend it.
    A lost receipt costs the next context its certainty, which is exactly the
    state this function replaces, and it says so on stderr rather than
    pretending.
    """
    account = os.environ.get("KV_ACCOUNT")
    namespace = os.environ.get("KV_NAMESPACE")
    token = os.environ.get("CLOUDFLARE_API_TOKEN")
    if not (account and namespace and token):
        print("tg-send: sent, but no Cloudflare credentials in the environment,"
              " so nothing recorded it; a later context cannot tell that this "
              "run already spoke", file=sys.stderr)
        return

    url = KV.format(account, namespace, CHATLOG)
    # Building the entry sits inside the guard with the network calls, and
    # KeyError with them, because "never fatal" has to hold for every way this
    # can fail and not just the ones that seem likely. Telegram always returns
    # message_id and date on success; a day it does not is still not a day this
    # process fails a delivered message (PR #184 review).
    try:
        entry = {
            "from": "bdfl",
            "message_id": sent["message_id"],
            "date": sent["date"],
            "text": summarize(body),
            "run_id": os.environ.get("GITHUB_RUN_ID"),
        }
        if reply_to is not None:
            entry["reply_to"] = reply_to
        log = kv_read(url, token)
        log.append(entry)
        kv_write(url, token, log[-KEEP:])
    except (OSError, ValueError, KeyError) as error:
        print(f"tg-send: sent, but the chat log was not updated: "
              f"{scrub(str(error), token)}", file=sys.stderr)


def summarize(body: str) -> str:
    """One scannable line of what was said, not a copy of it.

    The log is memory, not an archive: 40 entries have to be readable in one
    screenful, and the message itself is already in the operator's client.
    """
    line = " ".join(body.split())
    return line if len(line) <= SUMMARY else line[: SUMMARY - 1] + "…"


def kv_read(url: str, token: str) -> list:
    """The chat log as it stands, or an empty one.

    A missing key is an empty log, not a failure: that is the state before the
    first message ever sent. Anything else that is not a JSON array is
    corruption, and overwriting it costs less than a sender that refuses to
    record because someone once wrote a string there.
    """
    request = urllib.request.Request(url, headers=kv_headers(token))
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            log = json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return []
        raise
    except json.JSONDecodeError:
        return []
    return log if isinstance(log, list) else []


def kv_write(url: str, token: str, log: list) -> None:
    """Replace the chat log.

    Cloudflare's write endpoint takes multipart/form-data with a `value` part.
    A raw body gets a 400 whose message does not mention multipart, so the
    shape is spelled out here once instead of being rediscovered.
    """
    boundary = "----mothergod-chatlog"
    body = (f"--{boundary}\r\n"
            'Content-Disposition: form-data; name="value"\r\n\r\n'
            f"{json.dumps(log)}\r\n"
            f"--{boundary}--\r\n").encode()
    request = urllib.request.Request(
        url,
        data=body,
        method="PUT",
        headers={**kv_headers(token),
                 "Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    urllib.request.urlopen(request, timeout=20).close()


def kv_headers(token: str) -> dict:
    """Cloudflare's edge answers 403 to urllib's default User-Agent."""
    return {"Authorization": f"Bearer {token}", "User-Agent": UA}


def stop_typing() -> None:
    """Report one answer delivered, so the bot stops typing when none are owed.

    Not an unconditional stop: a run draining three queued messages sends three
    replies and must keep typing between them, so the worker counts and this
    decrements.

    Best effort on purpose. The indicator is decoration and the worker caps it
    on its own, so a failure here costs a stale indicator that expires, never a
    message. A missing secret means the caller is a job that was not given the
    worker's key; that is a valid configuration, not an error.
    """
    secret = os.environ.get("TELEGRAM_WEBHOOK_SECRET")
    if not secret:
        return
    request = urllib.request.Request(
        STOP_TYPING,
        data=b"",
        headers={"x-mothergod-secret": secret, "User-Agent": UA},
        method="POST",
    )
    try:
        urllib.request.urlopen(request, timeout=5).close()
    except OSError as error:  # HTTPError included; it subclasses OSError.
        print(f"tg-send: could not stop the typing indicator: "
              f"{scrub(str(error), secret)}", file=sys.stderr)


def scrub(message: str, token: str) -> str:
    """Never print a secret (hard rule 10), whoever built the string."""
    return message.replace(token, "<redacted>")


if __name__ == "__main__":
    sys.exit(main())
