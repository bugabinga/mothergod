#!/usr/bin/env python3
"""Deny background execution inside CI agent sessions (PreToolUse hook).

Extensionless and executable like tg-send and push-branch, but no agent
types this one: `.claude/settings.json` wires it as a PreToolUse hook and
the harness runs it before every matched tool call.

A GitHub Actions session ends the moment the model's turn ends. The
completion notification a backgrounded command or subagent promises can
never arrive, so work parked on it evaporates while the run reports
success. Prompt prose taught this twice (PR #271 after run 33098942211;
agent-review.yml after PR #255) and a third session still ended its turn
"waiting" (run 33207936812, 2026-08-28), because the harness's own tool
docs promise the notification and a buried prompt line loses to them.
Third occurrence means the rule stops being prose and becomes this guard
(ADR-0022).

A fourth session (run 33269388206, 2026-08-29) never touched the
structured field: it detached `cargo x check` at shell level, so this
guard, live and confirmed working, saw a foreground call and the job's
orphan cleanup killed the command anyway (PR #354). The command string
is part of the attack surface; the guard scans it too.

A fifth session (run 33363960344, 2026-08-31) made no denied call at
all: the harness itself moves a foreground command that outlives its
timeout to the background, after PreToolUse approval and with no
run_in_background field, then promises a notification headless mode
never delivers. No PreToolUse hook can see that path. The timeout env
in .claude/settings.json keeps real commands foreground (default 10
minutes, ceiling 30), and the deny-parked-turn Stop hook catches
whatever still detaches, at the boundary every variant shares.

Contract: reads the PreToolUse JSON on stdin. Outside GitHub Actions
(GITHUB_ACTIONS != "true") everything is allowed; an interactive session
really does get notifications. In CI, exit 2 (deny; stderr is shown to
the model) for Bash with run_in_background true or a command string
carrying a listed detach idiom (bare `&` control operator, a setsid
fork flag, bash's coprocess keyword), and for Agent, Task, or Workflow
calls unless run_in_background is explicitly false, because background
is those tools' default. Everything else exits 0. The idiom list is a
blocklist of what sessions have done or the runner hands them for free,
not a proof of coverage: the shell offers more ways to daemonize, and a
new one observed in the wild gets appended here, not to prose.

Liveness: every deny appends a line to GITHUB_STEP_SUMMARY, the durable
trace, and to the audit's record (`walls.py`), the only way a deny reaches
the artifact, which excludes transcripts by design; a broken hook
reference errors loudly in-session. A shell-detach deny's line also
names where its match sat (`[quoted]`, `[unquoted]`, `[unparsed]`), the
class the walls table's `detail` column carries, so the week's census
can tell inert text from a live detach (#1793).
"""

import json
import os
import re
import sys

import heredoc
import walls

# Tools that can detach work from the turn. Bash backgrounds only on
# request; the rest background by default, Workflow unconditionally.
DEFAULT_FOREGROUND = ("Bash",)
DEFAULT_BACKGROUND = ("Agent", "Task", "Workflow")

# The scan has no notion of quoting or nesting, so an idiom that is
# inert data (prose, a -c payload) still trips it: an accepted cost,
# because a quote-aware shell parser in a hook is entanglement this
# guard refuses, and the deny message names the rewrite. The same
# bluntness is what catches a live idiom inside `sh -c '...'`, after
# `eval`, or in an `xargs -I{}` template; #355's review showed any
# anchoring cheap enough for a hook opens those holes. One body is
# dropped before the scan: a quoted-delimiter heredoc fed to a posting
# script (`heredoc.POSTING`), which posts or commits what it reads and
# never runs it, so a `&` in a verdict or a commit message is prose by
# construction; that cost was 45 rewritten turns a week (#1377). Any
# other receiver keeps its body, `timeout 600 bash <<EOF` included:
# the list names what never executes, so an unknown reader fails
# closed; so does an unquoted delimiter, whose body bash expands before
# any reader sees it. Each entry: (pattern, step-summary reason).
#
# What the decision refuses to know, the record still says (#1793):
# each shell-detach deny is labeled by `span_class` with where its
# match sat, inside a quote or comment or outside one, so the census
# over a week of walls can tell the prose cost from the detaches the
# guard rightly stopped, before anyone argues for an allow. The label
# never touches the exit code: `sh -c 'setsid -f x'` is denied and
# labeled quoted, the hole #355 named, now counted.
SHELL_DETACH = (
    # Bare `&` control operator. The lookbehind clears `&&`, `>&`,
    # `<&`, `|&`; the lookahead clears `&&`, `&>`, and ampersands
    # embedded in tokens (`?a=1&b=2`). The closers after the `;` are
    # every one bash accepts directly against a control operator: the
    # subshell's `)`, a backtick substitution's closing backtick, and a
    # brace group's `}` (#1798: `{ x &}` runs, and the class had only
    # the first).
    (re.compile(r"(?<![&<>|])&(?=[\s;)`}]|$)"), "via shell &"),
    # setsid's fork flag daemonizes with no `&` anywhere, and setsid
    # ships on the Actions runner. Bundled short flags count; the
    # wait flag would block anyway, denied conservatively.
    (re.compile(r"\bsetsid\s+(-\w*f\w*\b|--fork\b)"), "via setsid fork"),
    # bash's coprocess keyword detaches by definition (PR #354 review).
    (re.compile(r"\bcoproc\b"), "via coproc"),
)

DETACH_MESSAGE = (
    "Background execution does not survive a CI session: the run ends "
    "the moment your turn ends, and the completion notification never "
    "arrives (PR #271, run 33207936812). Run the command in the "
    "foreground (default timeout 10 minutes, ceiling 30 via the "
    "timeout parameter); for a subagent pass "
    "run_in_background: false; a Workflow cannot run in CI at all. "
    "Work that cannot finish inside this run belongs to the next "
    "wake, stated where that wake will read it."
)

SHELL_DETACH_MESSAGE = (
    "A shell-level detach (bare `&`, a setsid fork, a coprocess) does "
    "not survive a CI session: the run ends the moment your turn ends "
    "and orphan cleanup kills the process (runs 33207936812, "
    "33269388206). Drop the detach and run the command in the "
    "foreground (default timeout 10 minutes, ceiling 30 via the "
    "timeout parameter). If the flagged idiom is text you are posting, "
    "feed it to the posting script through a heredoc (`gh-comment <n> "
    "<<'EOF'`), whose body this guard does not scan. Elsewhere reword "
    "it, for example `&` as 'and'; if it has to stay verbatim, as "
    "bitwise code does, write the file with the Write tool and pass "
    "the path to the command instead."
)


def span_class(scanned: str) -> str:
    """Where the detach idioms matched in `scanned` sat, for the record only.

    `unquoted` when any SHELL_DETACH pattern still matches with every
    quoted span and comment masked (heredoc.mask_quoted), so at least one
    match is live shell; `quoted` when masking removes every match;
    `unparsed` when the text ends inside a quote the scan could not
    close, or after a `$'` it does not model, so the masking is not
    trusted to say. Every pattern is tested, not only the one the reason
    names: in `echo "fish & chips"; setsid -f x` the reason is the
    quoted `&`, and the live setsid makes the class `unquoted`. The
    newline closes a comment that runs to the end, which is closed text,
    as `heredoc.continues` reads it; a quote stays open across it.
    "Quoted" is literal: a `$(...)` inside double quotes is masked too,
    though bash runs it.
    """
    masked, open_span = heredoc.mask_quoted(scanned + "\n")
    if any(pattern.search(masked) for pattern, _ in SHELL_DETACH):
        return "unquoted"
    return "unparsed" if open_span else "quoted"


def main() -> int:
    """Allow (0) or deny (2) the tool call described on stdin."""
    if os.environ.get("GITHUB_ACTIONS") != "true":
        return 0
    try:
        call = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    tool = call.get("tool_name", "")
    tool_input = call.get("tool_input")
    if not isinstance(tool_input, dict):
        tool_input = {}
    background = tool_input.get("run_in_background")
    reason = None
    detail = None
    if tool in DEFAULT_FOREGROUND:
        command = tool_input.get("command")
        if background is True:
            reason = "in background"
        elif isinstance(command, str):
            scanned = heredoc.without_posted_bodies(command)
            for pattern, why in SHELL_DETACH:
                if pattern.search(scanned):
                    reason = why
                    detail = span_class(scanned)
                    break
    elif tool in DEFAULT_BACKGROUND and background is not False:
        reason = "in background"
    if reason is None:
        return 0
    walls.denied("deny-ci-background", tool, f"denied {tool} {reason}", detail)
    message = DETACH_MESSAGE if reason == "in background" else SHELL_DETACH_MESSAGE
    print(message, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
